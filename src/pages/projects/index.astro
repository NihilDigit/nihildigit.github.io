---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import HrefIcon from "@/components/HrefIcon.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { inlineCode } from "@/utils/inlineCode";
import { SITE } from "@/config";

const all = await getCollection("projects");
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const spotlight = sorted.filter(p => p.data.spotlight);
---

<Layout title={`Projects · ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-10 pb-20">
    <header class="mb-10">
      <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
        Open Source
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Projects
      </h1>
      <p class="mt-3 max-w-prose-app text-muted-foreground">
        Things I build and maintain. Some are spun off from research; others
        scratch personal itches.
      </p>
    </header>

    {spotlight.length > 0 && (
      <section>
        <ul class="space-y-10">
          {spotlight.map(p => (
            <li class="max-w-prose-app">
              <a
                href={`https://github.com/${p.data.repo}`}
                target="_blank"
                rel="noopener"
                class="font-mono text-lg font-medium break-all transition-colors hover:text-accent"
              >
                {p.data.name}
              </a>
              <a
                href={`https://github.com/${p.data.repo}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors hover:text-accent"
              >
                <HrefIcon href={`https://github.com/${p.data.repo}`} />
                <span class="underline decoration-dotted underline-offset-4">
                  github.com/{p.data.repo}
                </span>
              </a>
              <p
                class="mt-3 text-sm leading-relaxed text-foreground/80"
                set:html={inlineCode(p.data.description)}
              />
              {p.data.links.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {p.data.links.map(l => (
                    <a href={l.href} target="_blank" rel="noopener" class="action-chip">
                      <HrefIcon href={l.href} class="size-4 shrink-0" />
                      {l.label}
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

  </main>
  <Footer />
</Layout>
