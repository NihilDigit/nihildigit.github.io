---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AnvilTeaser from "@/components/AnvilTeaser.astro";

const anvil = await getEntry("papers", "anvil");
if (!anvil) {
  throw new Error("ANVIL paper entry not found");
}

const fmtAuthors = (authors: { name: string; isMe?: boolean }[]) =>
  authors
    .map(a => (a.isMe ? `<strong class="text-foreground">${a.name}</strong>` : a.name))
    .join(", ");
---

<Layout title={`${anvil.data.title} · ${anvil.data.venue}`} description={anvil.data.tldr}>
  <Header />
  <main id="main-content" class="app-layout">
    <article class="pt-10 pb-20">
      <!-- Title block -->
      <header class="pb-10">
        <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          {anvil.data.venueDetail}
        </p>
        <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          {anvil.data.title}
        </h1>
        <p
          class="mt-4 text-base text-muted-foreground"
          set:html={fmtAuthors(anvil.data.authors)}
        />

        <div class="mt-6 flex flex-wrap gap-2">
          {
            anvil.data.links.map(l => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-md border border-border bg-muted/40 px-3.5 py-1.5 text-sm font-mono hover:border-accent hover:text-accent"
              >
                {l.label} <span aria-hidden>↗</span>
              </a>
            ))
          }
        </div>
      </header>

      <!-- Teaser video -->
      {anvil.data.teaserVideo && (
        <div class="mb-12">
          <AnvilTeaser
            src={anvil.data.teaserVideo}
            poster={anvil.data.teaserPoster}
            caption="Real-time 30 to 60 fps frame doubling on Snapdragon 8 Gen 3 (mpv-android-anvil)."
            priority
          />
        </div>
      )}

      <!-- TL;DR -->
      {anvil.data.tldr && (
        <section class="mb-12 border-l-2 border-accent pl-5">
          <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
            TL;DR
          </h2>
          <p class="mt-2 max-w-prose-app text-lg text-foreground">{anvil.data.tldr}</p>
        </section>
      )}

      <!-- Key numbers -->
      {anvil.data.keyNumbers && (
        <section class="mb-14">
          <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
            Key Numbers
          </h2>
          <dl class="grid grid-cols-1 gap-6 border-t border-border pt-6 sm:grid-cols-3">
            {anvil.data.keyNumbers.map(n => (
              <div>
                <dt class="metric-value text-3xl text-foreground sm:text-4xl">
                  {n.value}
                </dt>
                <dd class="mt-2 text-sm text-muted-foreground">{n.caption}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <!-- The problem -->
      <section class="mb-14 max-w-prose-app">
        <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          The Problem
        </h2>
        <h3 class="mb-4 text-2xl font-semibold tracking-tight">
          Real-time 1080p frame interpolation on a phone is structurally hard
        </h3>
        <div class="space-y-4 text-base leading-relaxed text-foreground">
          <p>
            Doubling 30 fps video to 60 fps on a phone gives you a hard 33.3 ms budget per
            synthesized frame. Modern mobile SoCs have an NPU that can hit it on paper, but the
            paper measures a different graph than the one frame interpolation methods actually
            ship. Three barriers show up the moment you try to deploy.
          </p>
          <p>
            <strong class="text-foreground">Operators don&rsquo;t map cleanly.</strong>
            Across nine surveyed VFI methods, the operators most flow-based architectures rely on
            are either slow or absent on mobile NPUs. <code class="font-mono text-sm">GridSample</code>
            (used by 7 of 9 methods) costs 3.2&times; a baseline conv on Qualcomm HTP and is
            unavailable through MediaTek&rsquo;s public NeuroPilot SDK. <code class="font-mono text-sm">Resize 2&times;</code>
            costs 4.4&times; on HTP and 12.6&times; on MediaTek APU. <code class="font-mono text-sm">PReLU</code>
            and <code class="font-mono text-sm">LayerNorm</code> are unmappable on MediaTek
            entirely. Self-attention OOMs at 1080p on both vendors.
          </p>
          <p>
            <strong class="text-foreground">INT8 is the only precision that fits, and iterative flow doesn&rsquo;t survive it.</strong>
            FP16 inference exceeds the 33.3 ms deadline on every device tested, even RIFE at 360p.
            INT8 is the practical operating point&mdash;but iterative flow methods collapse there.
            IFRNet&rsquo;s frame mode loses 4.38 dB PSNR under INT8; RIFE&rsquo;s flow-up mode loses
            0.89 dB. Per-operator instrumentation localizes the failure to a single pattern:
            quantized <code class="font-mono text-sm">Add</code> on recurrent flow states (more on
            this below).
          </p>
          <p>
            <strong class="text-foreground">The graph is memory-bound.</strong>
            Profiling RIFE 360p FP16 on HTP V75, convolutions account for only 5.1% of inference
            cycles. The other 95% is <code class="font-mono text-sm">Resize</code>,
            <code class="font-mono text-sm">GridSample</code>, <code class="font-mono text-sm">Div</code>,
            <code class="font-mono text-sm">Add</code>, <code class="font-mono text-sm">Mul</code>,
            <code class="font-mono text-sm">Concat</code>, <code class="font-mono text-sm">PReLU</code>,
            <code class="font-mono text-sm">Slice</code>. Mobile NPUs are tuned for compute-bound
            operators; this graph is the opposite.
          </p>
        </div>
      </section>

      <!-- The idea -->
      <section class="mb-14 max-w-prose-app">
        <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          The Idea
        </h2>
        <h3 class="mb-4 text-2xl font-semibold tracking-tight">
          The motion vectors are already in the bitstream. Use them.
        </h3>
        <div class="space-y-4 text-base leading-relaxed text-foreground">
          <p>
            The H.264/AVC decoder produces block-level motion vectors as a byproduct of normal
            playback. They are noisy, blocky, and not flow fields&mdash;but they are free. ANVIL
            takes them out of the decoder, smooths them on the GPU, and uses them to prealign the
            two input frames <em>before</em> anything reaches the NPU.
          </p>
          <p>
            That single move dissolves the three barriers. There is no learned optical flow on the
            NPU, so no <code class="font-mono text-sm">GridSample</code> and no iterative
            refinement. The remaining job for the NPU is small: take the two prealigned frames
            and predict a residual that fixes whatever the codec MVs got wrong. That residual
            network is just convolutions and ReLUs, which mobile NPUs are good at.
          </p>
          <p>
            The result is an inference graph that looks unlike a 2024 VFI architecture and a lot
            like a 2018 image-to-image network. That&rsquo;s on purpose.
          </p>
        </div>
      </section>

      <!-- Architecture figure -->
      <section class="mb-14">
        <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Architecture
        </h2>
        <figure class="rounded-md border border-border bg-muted/20 p-4 sm:p-6">
          <img
            src="/anvil/figures/architecture.png"
            alt="UNet-v3b architecture diagram showing 4-level encoder, ResBlock bottleneck, and decoder with additive skip connections"
            class="w-full"
            loading="lazy"
          />
          <figcaption class="mt-4 max-w-prose-app text-sm text-muted-foreground">
            <span class="font-mono text-xs uppercase tracking-widest">Fig. 1 &mdash; UNet-v3b residual network.</span>
            Six channels in (the two prealigned frames stacked), three channels out (a residual added
            to the average of the prealigned pair). Encoder widths are
            <code class="font-mono text-xs">[16, 32, 64, 64]</code> for ANVIL-S and
            <code class="font-mono text-xs">[16, 32, 96, 96]</code> for ANVIL-M.
            Skip connections are additive, not concat-based: this kept latency 17&ndash;26% lower
            in same-session A/B tests because the NPU never has to materialize the wide concat
            tensors. Batch-norm folds into the conv weights at deploy time, so the runtime graph
            is plain Conv + ReLU.
          </figcaption>
        </figure>
      </section>

      <!-- System pipeline -->
      <section class="mb-14">
        <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          System Pipeline
        </h2>
        <figure class="rounded-md border border-border bg-muted/20 p-4 sm:p-6">
          <img
            src="/anvil/figures/pipeline.png"
            alt="Three-processor pipeline: H.264 decode and CPU prealign, GPU smoothing and warp, HTP INT8 inference, GPU post-process"
            class="w-full"
            loading="lazy"
          />
          <figcaption class="mt-4 max-w-prose-app text-sm text-muted-foreground">
            <span class="font-mono text-xs uppercase tracking-widest">Fig. 2 &mdash; Three-processor pipeline.</span>
            CPU densifies the H.264 motion vectors, downsamples 4&times;, and packs the YUV input
            (~2.9 ms). GPU does median-5 + Gaussian smoothing and the sub-pixel warp via a Vulkan
            compute shader, finishing with INT8 quantization in the same dispatch (~3.7 ms). HTP
            runs the residual network at INT8 (12.8&ndash;17.0 ms depending on thermal state). GPU
            post-process dequantizes, adds the residual, and converts to YUV420 (~3.3 ms). CPU/GPU
            preparation for frame N+1 overlaps with HTP inference for frame N via double-buffered
            I/O.
          </figcaption>
        </figure>
      </section>

      <!-- Results -->
      <section class="mb-14">
        <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Results
        </h2>

        <h3 class="mb-3 text-xl font-semibold tracking-tight">End-to-end latency on Snapdragon 8 Gen 3</h3>
        <p class="mb-5 max-w-prose-app text-base leading-relaxed text-foreground">
          Median over 54,623 consecutive frame pairs (30-minute continuous 1080p playback,
          SM8650, ANVIL-S INT8). 94.9% of frame pairs complete within the 33.3 ms budget; the
          5.1% that don&rsquo;t are concentrated in the late thermal phase.
        </p>
        <div class="mb-6 overflow-x-auto rounded-md border border-border">
          <table class="w-full text-sm">
            <thead class="bg-muted/40 font-mono text-xs uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="px-4 py-3 text-left font-medium">Stage</th>
                <th class="px-4 py-3 text-left font-medium">Hardware</th>
                <th class="px-4 py-3 text-right font-medium">Latency</th>
                <th class="px-4 py-3 text-left font-medium">Operation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="px-4 py-3 font-mono text-xs">P1a</td>
                <td class="px-4 py-3">CPU</td>
                <td class="px-4 py-3 text-right font-mono">2.9 ms</td>
                <td class="px-4 py-3 text-foreground/80">ZOH densify + 4&times; downsample + YUV pack</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-mono text-xs">P1b + P2</td>
                <td class="px-4 py-3">GPU</td>
                <td class="px-4 py-3 text-right font-mono">3.7 ms</td>
                <td class="px-4 py-3 text-foreground/80">median-5 + Gaussian &sigma;=2 + warp + quant</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-mono text-xs">Copy</td>
                <td class="px-4 py-3">CPU</td>
                <td class="px-4 py-3 text-right font-mono">0.9 ms</td>
                <td class="px-4 py-3 text-foreground/80">12 MB uint8 NHWC to QNN buffer</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-mono text-xs">P3</td>
                <td class="px-4 py-3">HTP</td>
                <td class="px-4 py-3 text-right font-mono">17.0 ms</td>
                <td class="px-4 py-3 text-foreground/80">INT8 graphExecute (async, pipelined)</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-mono text-xs">P4</td>
                <td class="px-4 py-3">GPU</td>
                <td class="px-4 py-3 text-right font-mono">3.3 ms</td>
                <td class="px-4 py-3 text-foreground/80">dequant + residual + RGB&rarr;YUV420</td>
              </tr>
              <tr class="bg-muted/30 font-medium">
                <td class="px-4 py-3" colspan="2">Total per pair (median)</td>
                <td class="px-4 py-3 text-right font-mono">28.4 ms</td>
                <td class="px-4 py-3 text-foreground/80">94.9% &le; 33.3 ms</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight">NPU forward-pass latency at 1080p INT8</h3>
        <p class="mb-5 max-w-prose-app text-base leading-relaxed text-foreground">
          Network-only inference, three Snapdragon generations. RIFE has to drop to 360p to even
          attempt the budget. ANVIL holds 1080p across two generations. Older HTP V69 silicon
          fails for everyone.
        </p>
        <div class="mb-6 overflow-x-auto rounded-md border border-border">
          <table class="w-full text-sm">
            <thead class="bg-muted/40 font-mono text-xs uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="px-4 py-3 text-left font-medium">SoC</th>
                <th class="px-4 py-3 text-left font-medium">NPU</th>
                <th class="px-4 py-3 text-right font-medium">ANVIL-S</th>
                <th class="px-4 py-3 text-right font-medium">ANVIL-M</th>
                <th class="px-4 py-3 text-right font-medium">RIFE (360p)</th>
                <th class="px-4 py-3 text-center font-medium">&le; 33.3 ms</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="px-4 py-3">SD 7+ Gen 2</td>
                <td class="px-4 py-3">HTP V69</td>
                <td class="px-4 py-3 text-right font-mono">46.0 ms</td>
                <td class="px-4 py-3 text-right font-mono">56.6 ms</td>
                <td class="px-4 py-3 text-right font-mono">45.6 ms</td>
                <td class="px-4 py-3 text-center text-muted-foreground">&times;</td>
              </tr>
              <tr>
                <td class="px-4 py-3">SD 8 Gen 2</td>
                <td class="px-4 py-3">HTP V73</td>
                <td class="px-4 py-3 text-right font-mono">15.5 ms</td>
                <td class="px-4 py-3 text-right font-mono">20.8 ms</td>
                <td class="px-4 py-3 text-right font-mono">20.7 ms</td>
                <td class="px-4 py-3 text-center text-accent">&check;</td>
              </tr>
              <tr>
                <td class="px-4 py-3">SD 8 Gen 3</td>
                <td class="px-4 py-3">HTP V75</td>
                <td class="px-4 py-3 text-right font-mono">12.8 ms</td>
                <td class="px-4 py-3 text-right font-mono">16.7 ms</td>
                <td class="px-4 py-3 text-right font-mono">14.7 ms</td>
                <td class="px-4 py-3 text-center text-accent">&check;</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="max-w-prose-app text-sm text-muted-foreground">
          On MediaTek (NeuroPilot Public SDK), ANVIL-S runs all operators APU-delegated at 1080p
          INT8: 24.4 ms on Dimensity 9300, 25.5 ms on Dimensity 9400+. The MediaTek path uses
          runtime compilation, so absolute timings aren&rsquo;t directly comparable to Qualcomm; the
          point is that the operator set is portable.
        </p>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight">Quality vs. RIFE on Vimeo90K and Xiph 1080p</h3>
        <div class="mb-6 overflow-x-auto rounded-md border border-border">
          <table class="w-full text-sm">
            <thead class="bg-muted/40 font-mono text-xs uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="px-4 py-3 text-left font-medium">Method</th>
                <th class="px-4 py-3 text-right font-medium">Params</th>
                <th class="px-4 py-3 text-right font-medium">Vimeo PSNR</th>
                <th class="px-4 py-3 text-right font-medium">Vimeo LPIPS</th>
                <th class="px-4 py-3 text-right font-medium">Xiph PSNR</th>
                <th class="px-4 py-3 text-left font-medium">Deployable?</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="px-4 py-3 text-muted-foreground">MV Blend (zero-param)</td>
                <td class="px-4 py-3 text-right font-mono">0</td>
                <td class="px-4 py-3 text-right font-mono">31.20</td>
                <td class="px-4 py-3 text-right font-mono">0.053</td>
                <td class="px-4 py-3 text-right font-mono">28.98</td>
                <td class="px-4 py-3 text-muted-foreground">&mdash;</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium">ANVIL-S</td>
                <td class="px-4 py-3 text-right font-mono">855K</td>
                <td class="px-4 py-3 text-right font-mono">33.45</td>
                <td class="px-4 py-3 text-right font-mono">0.037</td>
                <td class="px-4 py-3 text-right font-mono">29.65</td>
                <td class="px-4 py-3 text-accent">Yes</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium">ANVIL-M</td>
                <td class="px-4 py-3 text-right font-mono">2.66M</td>
                <td class="px-4 py-3 text-right font-mono">33.66</td>
                <td class="px-4 py-3 text-right font-mono">0.036</td>
                <td class="px-4 py-3 text-right font-mono">29.74</td>
                <td class="px-4 py-3 text-accent">Yes</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-muted-foreground">RIFE HDv3</td>
                <td class="px-4 py-3 text-right font-mono">3.04M</td>
                <td class="px-4 py-3 text-right font-mono">34.26</td>
                <td class="px-4 py-3 text-right font-mono">0.019</td>
                <td class="px-4 py-3 text-right font-mono">30.04</td>
                <td class="px-4 py-3 text-muted-foreground">No (grid_sample + INT8)</td>
              </tr>
              <tr>
                <td class="px-4 py-3 text-muted-foreground">NAFNet ceiling</td>
                <td class="px-4 py-3 text-right font-mono">17.1M</td>
                <td class="px-4 py-3 text-right font-mono">34.58</td>
                <td class="px-4 py-3 text-right font-mono">0.030</td>
                <td class="px-4 py-3 text-right font-mono">30.30</td>
                <td class="px-4 py-3 text-muted-foreground">No (LayerNorm)</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="max-w-prose-app text-sm text-muted-foreground">
          ANVIL-M trails non-deployable RIFE by 0.6 dB PSNR on Vimeo and 0.3 dB on Xiph. LPIPS is
          worse (0.036 vs. 0.019), reflecting the smoothness bias of residual prediction versus
          sub-pixel warping. The NAFNet ceiling has the same gap, so it&rsquo;s a structural
          property of residual VFI rather than a capacity issue.
        </p>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight">Visual comparison</h3>
        <figure class="rounded-md border border-border bg-muted/20 p-4 sm:p-6">
          <img
            src="/anvil/figures/qualitative.jpg"
            alt="Visual comparison of ANVIL-M, RIFE HDv3, and ground truth on three Xiph 1080p sequences"
            class="w-full rounded-sm"
            loading="lazy"
          />
          <figcaption class="mt-4 max-w-prose-app text-sm text-muted-foreground">
            <span class="font-mono text-xs uppercase tracking-widest">Fig. 3 &mdash; Three failure modes on Xiph 1080p (3&times; insets).</span>
            <em>old_town_cross</em> (slow pan): ANVIL&rsquo;s smoothing suppresses noise (+0.7 dB
            vs. RIFE) but loses fine detail. <em>tractor</em> (large rigid motion): ANVIL
            over-smooths edges; RIFE produces ghosting. <em>riverbed</em> (stochastic texture):
            both paradigms collapse&mdash;non-rigid motion defeats both. The smoothness bias
            helps low-texture regions and hurts high-frequency detail.
          </figcaption>
        </figure>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight">Capacity scaling</h3>
        <figure class="rounded-md border border-border bg-muted/20 p-4 sm:p-6">
          <img
            src="/anvil/figures/scaling.png"
            alt="Vimeo90K PSNR vs. parameter count for ANVIL variants, RIFE HDv3, and NAFNet ceiling"
            class="mx-auto max-w-xl"
            loading="lazy"
          />
          <figcaption class="mt-4 max-w-prose-app text-sm text-muted-foreground">
            <span class="font-mono text-xs uppercase tracking-widest">Fig. 4 &mdash; PSNR vs. parameter count on Vimeo90K.</span>
            Quality scales smoothly with capacity from 1.8K to 2.66M params; smoothed prealignment
            shifts the entire curve up. ANVIL-S/M sit close to the RIFE HDv3 reference line at
            comparable parameter counts and trend toward the 17.1M NAFNet ceiling. The framework
            has not saturated.
          </figcaption>
        </figure>
      </section>

      <!-- The quantization story -->
      <section class="mb-14 max-w-prose-app">
        <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          The Quantization Story
        </h2>
        <h3 class="mb-4 text-2xl font-semibold tracking-tight">
          Why iterative flow methods break under INT8
        </h3>
        <div class="space-y-4 text-base leading-relaxed text-foreground">
          <p>
            INT8 post-training quantization usually loses fractions of a dB on classification and
            detection networks. On iterative flow VFI it loses 4 dB. Per-operator instrumentation
            on RIFE and IFRNet shows the failure follows the same pattern in both:
          </p>
          <ol class="ml-6 list-decimal space-y-2 text-foreground">
            <li>Quantizing convolutions introduces a small initial error (CosSim drops 0.048 for RIFE, 0.055 for IFRNet). Acceptable.</li>
            <li>Quantizing PReLU adds zero further degradation. Benign.</li>
            <li>
              Quantizing <code class="font-mono text-sm">Add</code> triggers collapse. CosSim
              drops to 0.815 on RIFE and 0.878 on IFRNet. This is the only operator that matters.
            </li>
            <li>Full W8A8 &asymp; Conv + Add. Nothing else contributes meaningfully.</li>
          </ol>
          <p>
            The mechanism: iterative VFI accumulates flow as
            <code class="font-mono text-sm">f<sub>accum</sub> = f<sub>accum</sub> + &Delta;f</code>
            across stages. Each stage&rsquo;s quantized output feeds the next, and trained flow
            states have a wide dynamic range (&plusmn;19 px for RIFE, &plusmn;11 px for IFRNet)
            that doesn&rsquo;t fit cleanly in 8 bits. The error compounds.
          </p>
          <p>
            ANVIL avoids the trap by construction. There is no recurrent flow state, so no
            <code class="font-mono text-sm">Add</code>-on-recurrent-state to amplify. The
            residuals it does predict have range &plusmn;0.25, comfortably within INT8. There is
            no <code class="font-mono text-sm">grid_sample</code> on the NPU, so quantization
            noise can&rsquo;t bounce through a sampler. ANVIL-S loses 0.19 dB under INT8;
            ANVIL-M loses 0.09 dB.
          </p>
        </div>
      </section>

      <!-- Components -->
      <section class="mb-14 max-w-prose-app">
        <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Components
        </h2>
        <div class="space-y-8">
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h3 class="text-xl font-semibold tracking-tight">
                <code class="font-mono">anvil</code>
              </h3>
              <a
                href="https://github.com/NihilDigit/anvil"
                target="_blank"
                rel="noopener"
                class="font-mono text-xs text-muted-foreground hover:text-accent"
              >
                github.com/NihilDigit/anvil &rarr;
              </a>
            </div>
            <p class="mt-3 text-base leading-relaxed text-foreground">
              Training and evaluation code for ANVIL-S and ANVIL-M, plus the ONNX export and INT8
              calibration pipeline. Includes the per-operator quantization instrumentation used to
              localize the iterative-flow collapse, the cross-vendor operator benchmark
              (Qualcomm HTP, MediaTek APU), and the comparative evaluations against RIFE and
              IFRNet on Vimeo90K and Xiph 1080p.
            </p>
          </div>
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h3 class="text-xl font-semibold tracking-tight">
                <code class="font-mono">mpv-android-anvil</code>
              </h3>
              <a
                href="https://github.com/NihilDigit/mpv-android-anvil"
                target="_blank"
                rel="noopener"
                class="font-mono text-xs text-muted-foreground hover:text-accent"
              >
                github.com/NihilDigit/mpv-android-anvil &rarr;
              </a>
            </div>
            <p class="mt-3 text-base leading-relaxed text-foreground">
              A fork of mpv-android that runs the full three-processor pipeline live: software
              H.264 decode (via FFmpeg, since Android&rsquo;s MediaCodec doesn&rsquo;t expose
              per-macroblock MVs), a Vulkan compute shader for smoothing and warp, and Qualcomm
              QNN/HTP for INT8 inference. Includes an A/B toggle for direct visual comparison and
              ships with four Xiph 1080p test sequences. The teaser at the top of this page is
              recorded from this player.
            </p>
          </div>
        </div>
      </section>

      <!-- Abstract -->
      <section class="mb-14 max-w-prose-app">
        <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Abstract
        </h2>
        <p class="text-base leading-relaxed text-foreground/80">
          {anvil.data.abstract}
        </p>
      </section>

      <!-- Limitations -->
      <section class="mb-14 max-w-prose-app">
        <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Limitations
        </h2>
        <div class="space-y-4 text-base leading-relaxed text-foreground">
          <p>
            ANVIL is built on a specific assumption: the decoder hands you motion vectors. Today
            that means H.264/AVC playback with software decoding through FFmpeg. Android&rsquo;s
            hardware MediaCodec path doesn&rsquo;t expose per-macroblock MVs, so the demo player
            uses libavcodec on the CPU. Generalization to HEVC and AV1, and to playback paths
            without decoder access, is left to future work.
          </p>
          <p>
            On the quality side, residual prediction is structurally smoother than sub-pixel
            warping. ANVIL&rsquo;s LPIPS is roughly 2&times; worse than RIFE&rsquo;s on Xiph
            1080p (0.148 vs. 0.077). The same gap appears in the 17.1M-parameter NAFNet ceiling,
            so it&rsquo;s a property of the paradigm, not of the model size. Perceptual-loss
            fine-tuning could partly close it, provided the result still survives INT8.
          </p>
          <p>
            Thermal throttling matters. The 28.4 ms median holds in the warm steady state
            (minutes 6&ndash;21 of a 30-minute playback); the hot phase (minutes 22&ndash;30)
            has an 11% frame-drop rate vs. 2&ndash;3% in steady state. A thermal-aware
            frame-skip policy is a reasonable mitigation.
          </p>
        </div>
      </section>

      <!-- BibTeX -->
      {anvil.data.bibtex && (
        <section class="mt-16 border-t border-border pt-10">
          <div class="mb-3 flex items-baseline justify-between">
            <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
              BibTeX
            </h2>
            <button
              type="button"
              data-bibtex-copy
              class="font-mono text-xs text-muted-foreground hover:text-accent"
            >
              Copy
            </button>
          </div>
          <pre class="overflow-x-auto rounded-md border border-border bg-muted/30 p-4 text-xs leading-relaxed"><code data-bibtex-text>{anvil.data.bibtex}</code></pre>
        </section>
      )}
    </article>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.querySelector("[data-bibtex-copy]");
    const code = document.querySelector<HTMLElement>("[data-bibtex-text]");
    if (!btn || !code) return;
    btn.addEventListener("click", async () => {
      const orig = btn.textContent;
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = orig), 1200);
      } catch {
        // Clipboard API unavailable (insecure context, old browsers).
        // Select the BibTeX so the user can finish the copy with Cmd/Ctrl+C.
        const range = document.createRange();
        range.selectNodeContents(code);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = "Selected — Cmd/Ctrl+C";
        setTimeout(() => (btn.textContent = orig), 2400);
      }
    });
  });
</script>
