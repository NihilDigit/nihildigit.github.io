---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AnvilTeaser from "@/components/AnvilTeaser.astro";
import HrefIcon from "@/components/HrefIcon.astro";

const anvil = await getEntry("papers", "anvil");
if (!anvil) {
  throw new Error("ANVIL paper entry not found");
}

const fmtAuthors = (authors: { name: string; isMe?: boolean }[]) =>
  authors
    .map(a =>
      a.isMe
        ? `<strong class="font-medium text-foreground">${a.name}</strong>`
        : a.name
    )
    .join(", ");

const inlineCode =
  "rounded border border-border-subtle bg-code-bg px-1.5 py-0.5 font-mono text-[0.84em] text-foreground";
---

<Layout
  title={`${anvil.data.title} | ${anvil.data.venue}`}
  description={anvil.data.tldr}
  ogImage="/og/anvil.png"
  pubDatetime={anvil.data.pubDatetime}
  schemaType="ScholarlyArticle"
>
  <Header />
  <main id="main-content" class="app-layout">
    <article class="pt-9 pb-20 sm:pt-11">
      <!-- Title block -->
      <header class="pb-9">
        <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs tracking-wide text-muted-foreground">
          {
            anvil.data.venueHref ? (
              <a
                href={anvil.data.venueHref}
                target="_blank"
                rel="noopener"
                class="font-medium text-foreground-secondary underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >
                {anvil.data.venueDetail ?? anvil.data.venue}
              </a>
            ) : (
              <span class="font-medium text-foreground-secondary">
                {anvil.data.venueDetail ?? anvil.data.venue}
              </span>
            )
          }
          <span aria-hidden="true" class="h-3 w-px bg-border"></span>
          <span>{anvil.data.venue}</span>
          <span aria-hidden="true" class="h-3 w-px bg-border"></span>
          <span class="tabular-nums">{anvil.data.year}</span>
        </p>

        <h1 class="mt-3 text-3xl font-semibold leading-[1.16] tracking-tight text-foreground sm:text-4xl">
          {anvil.data.title}
        </h1>
        <p
          class="mt-3.5 text-base text-muted-foreground"
          set:html={fmtAuthors(anvil.data.authors)}
        />

        <div class="mt-5 flex flex-wrap gap-2">
          {
            anvil.data.links.map(l => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="action-chip"
              >
                <HrefIcon href={l.href} class="size-4 shrink-0" />
                {l.label}
              </a>
            ))
          }
        </div>

        <nav aria-label="On this page" class="jump-nav mt-7">
          <a href="#problem">Problem</a>
          <a href="#idea">Idea</a>
          <a href="#architecture">Architecture</a>
          <a href="#pipeline">Pipeline</a>
          <a href="#results">Results</a>
          <a href="#components">Components</a>
          <a href="#bibtex">BibTeX</a>
        </nav>
      </header>

      <!-- Teaser and TL;DR side by side from md up -->
      <div class="mb-10 grid gap-5 md:grid-cols-2 md:items-start">
        {
          anvil.data.teaserVideo && (
            <AnvilTeaser
              src={anvil.data.teaserVideo}
              poster={anvil.data.teaserPoster}
              rounded="rounded-lg"
              caption="Real-time 30 to 60 fps frame doubling on Snapdragon 8 Gen 3 (mpv-android-anvil)."
              priority
            />
          )
        }

        {
          anvil.data.tldr && (
            <section class="surface-card p-5 sm:p-6">
              <h2 class="section-eyebrow-plain">TL;DR</h2>
              <p class="mt-3 text-base leading-relaxed text-foreground-secondary">
                {anvil.data.tldr}
              </p>
            </section>
          )
        }
      </div>

      <!-- Key numbers -->
      {
        anvil.data.keyNumbers && (
          <section class="mb-14">
            <h2 class="section-eyebrow mb-4">Key Numbers</h2>
            <dl class="grid grid-cols-1 gap-3.5 sm:grid-cols-3 sm:gap-4">
              {anvil.data.keyNumbers.map(n => (
                <div class="surface-card flex flex-col justify-between px-4 py-4 sm:px-5">
                  <dt class="metric-value text-2xl leading-snug text-foreground sm:text-3xl">
                    {n.value}
                  </dt>
                  <dd class="mt-2.5 border-t border-border-subtle pt-2.5 text-xs leading-relaxed text-muted-foreground">
                    {n.caption}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <!-- The problem -->
      <section id="problem" class="mb-14">
        <p class="section-eyebrow mb-4">The Problem</p>
        <div class="max-w-prose-app">
          <h2 class="mb-4 text-2xl font-semibold tracking-tight text-foreground">
            Real-time 1080p frame interpolation on a phone is structurally hard
          </h2>
          <div class="space-y-4 text-base leading-relaxed text-foreground-secondary">
          <p>
            Doubling 30 fps video to 60 fps on a phone gives you a hard 33.3 ms budget per
            synthesized frame. Modern mobile SoCs have an NPU that can hit it on paper, but the
            paper measures a different graph than the one frame interpolation methods actually
            ship. Three barriers show up the moment you try to deploy.
          </p>
          <p>
            <strong class="font-semibold text-foreground">Operators don&rsquo;t map cleanly.</strong>
            Across nine surveyed VFI methods, the operators most flow-based architectures rely on
            are either slow or absent on mobile NPUs. <code class={inlineCode}>GridSample</code>
            (used by 7 of 9 methods) costs 3.2&times; a baseline conv on Qualcomm HTP and is
            unavailable through MediaTek&rsquo;s public NeuroPilot SDK. <code class={inlineCode}>Resize 2&times;</code>
            costs 4.4&times; on HTP and 12.6&times; on MediaTek APU. <code class={inlineCode}>PReLU</code>
            and <code class={inlineCode}>LayerNorm</code> are unmappable on MediaTek
            entirely. Self-attention OOMs at 1080p on both vendors.
          </p>
          <p>
            <strong class="font-semibold text-foreground">INT8 is the only precision that fits, and iterative flow doesn&rsquo;t survive it.</strong>
            FP16 inference exceeds the 33.3 ms deadline on every device tested, even RIFE at 360p.
            INT8 is the practical operating point&mdash;but iterative flow methods collapse there.
            IFRNet&rsquo;s frame mode loses 4.38 dB PSNR under INT8; RIFE&rsquo;s flow-up mode loses
            0.89 dB. Per-operator instrumentation localizes the failure to a single pattern:
            quantized <code class={inlineCode}>Add</code> on recurrent flow states (more on
            this below).
          </p>
          <p>
            <strong class="font-semibold text-foreground">The graph is memory-bound.</strong>
            Profiling RIFE 360p FP16 on HTP V75, convolutions account for only 5.1% of inference
            cycles. The other 95% is <code class={inlineCode}>Resize</code>,
            <code class={inlineCode}>GridSample</code>, <code class={inlineCode}>Div</code>,
            <code class={inlineCode}>Add</code>, <code class={inlineCode}>Mul</code>,
            <code class={inlineCode}>Concat</code>, <code class={inlineCode}>PReLU</code>,
            <code class={inlineCode}>Slice</code>. Mobile NPUs are tuned for compute-bound
            operators; this graph is the opposite.
          </p>
          </div>
        </div>
      </section>

      <!-- The idea -->
      <section id="idea" class="mb-14">
        <p class="section-eyebrow mb-4">Core Idea</p>
        <div class="max-w-prose-app">
          <h2 class="mb-4 text-2xl font-semibold tracking-tight text-foreground">
            The motion vectors are already in the bitstream. Use them.
          </h2>
          <div class="space-y-4 text-base leading-relaxed text-foreground-secondary">
          <p>
            The H.264/AVC decoder produces block-level motion vectors as a byproduct of normal
            playback. They are noisy, blocky, and not flow fields&mdash;but they are free. ANVIL
            takes them out of the decoder, smooths them on the GPU, and uses them to prealign the
            two input frames <em class="text-foreground">before</em> anything reaches the NPU.
          </p>
          <p>
            That single move dissolves the three barriers. There is no learned optical flow on the
            NPU, so no <code class={inlineCode}>GridSample</code> and no iterative
            refinement. The remaining job for the NPU is small: take the two prealigned frames
            and predict a residual that fixes whatever the codec MVs got wrong. That residual
            network is just convolutions and ReLUs, which mobile NPUs are good at.
          </p>
          <p>
            The result is an inference graph that looks unlike a 2024 VFI architecture and a lot
            like a 2018 image-to-image network. That&rsquo;s on purpose.
          </p>
          </div>
        </div>
      </section>

      <!-- Architecture figure -->
      <section id="architecture" class="mb-14">
        <h2 class="section-eyebrow mb-4">Architecture</h2>
        <figure class="figure-frame">
          <div class="figure-paper">
            <img
              src="/anvil/figures/architecture.png"
              alt="UNet-v3b architecture diagram showing 4-level encoder, ResBlock bottleneck, and decoder with additive skip connections"
              class="w-full"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
            <span class="font-medium text-foreground">Fig. 1 &mdash; UNet-v3b residual network.</span>
            Six channels in (the two prealigned frames stacked), three channels out (a residual added
            to the average of the prealigned pair). Encoder widths are
            <code class={inlineCode}>[16, 32, 64, 64]</code> for ANVIL-S and
            <code class={inlineCode}>[16, 32, 96, 96]</code> for ANVIL-M.
            Skip connections are additive, not concat-based: this kept latency 17&ndash;26% lower
            in same-session A/B tests because the NPU never has to materialize the wide concat
            tensors. Batch-norm folds into the conv weights at deploy time, so the runtime graph
            is plain Conv + ReLU.
          </figcaption>
        </figure>
      </section>

      <!-- System pipeline -->
      <section id="pipeline" class="mb-14">
        <h2 class="section-eyebrow mb-4">System Pipeline</h2>
        <figure class="figure-frame">
          <div class="figure-paper">
            <img
              src="/anvil/figures/pipeline.png"
              alt="Three-processor pipeline: H.264 decode and CPU prealign, GPU smoothing and warp, HTP INT8 inference, GPU post-process"
              class="w-full"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
            <span class="font-medium text-foreground">Fig. 2 &mdash; Three-processor pipeline.</span>
            CPU densifies the H.264 motion vectors, downsamples 4&times;, and packs the YUV input
            (~2.9 ms). GPU does median-5 + Gaussian smoothing and the sub-pixel warp via a Vulkan
            compute shader, finishing with INT8 quantization in the same dispatch (~3.7 ms). HTP
            runs the residual network at INT8 (12.8&ndash;17.0 ms depending on thermal state). GPU
            post-process dequantizes, adds the residual, and converts to YUV420 (~3.3 ms). CPU/GPU
            preparation for frame N+1 overlaps with HTP inference for frame N via double-buffered
            I/O.
          </figcaption>
        </figure>
      </section>

      <!-- Results -->
      <section id="results" class="mb-14">
        <h2 class="section-eyebrow mb-5">Results</h2>

        <h3 class="mb-3 text-xl font-semibold tracking-tight text-foreground">
          End-to-end latency on Snapdragon 8 Gen 3
        </h3>
        <p class="mb-4 max-w-prose-app text-base leading-relaxed text-foreground-secondary">
          Median over 54,623 consecutive frame pairs (30-minute continuous 1080p playback,
          SM8650, ANVIL-S INT8). 94.9% of frame pairs complete within the 33.3 ms budget; the
          5.1% that don&rsquo;t are concentrated in the late thermal phase.
        </p>
        <div class="data-table-wrap mb-4">
          <table class="data-table">
            <thead>
              <tr>
                <th class="text-left">Stage</th>
                <th class="text-left">Hardware</th>
                <th class="text-right">Latency</th>
                <th class="text-left">Operation</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-mono text-xs text-foreground">P1a</td>
                <td>CPU</td>
                <td class="text-right font-mono">2.9 ms</td>
                <td class="text-foreground-secondary">ZOH densify + 4&times; downsample + YUV pack</td>
              </tr>
              <tr>
                <td class="font-mono text-xs text-foreground">P1b + P2</td>
                <td>GPU</td>
                <td class="text-right font-mono">3.7 ms</td>
                <td class="text-foreground-secondary">median-5 + Gaussian &sigma;=2 + warp + quant</td>
              </tr>
              <tr>
                <td class="font-mono text-xs text-foreground">Copy</td>
                <td>CPU</td>
                <td class="text-right font-mono">0.9 ms</td>
                <td class="text-foreground-secondary">12 MB uint8 NHWC to QNN buffer</td>
              </tr>
              <tr>
                <td class="font-mono text-xs text-foreground">P3</td>
                <td>HTP</td>
                <td class="text-right font-mono">17.0 ms</td>
                <td class="text-foreground-secondary">INT8 graphExecute (async, pipelined)</td>
              </tr>
              <tr>
                <td class="font-mono text-xs text-foreground">P4</td>
                <td>GPU</td>
                <td class="text-right font-mono">3.3 ms</td>
                <td class="text-foreground-secondary">dequant + residual + RGB&rarr;YUV420</td>
              </tr>
              <tr class="row-highlight">
                <td colspan="2" class="text-foreground">Total per pair (median)</td>
                <td class="text-right font-mono text-foreground">28.4 ms</td>
                <td class="text-foreground">94.9% &le; 33.3 ms</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight text-foreground">
          NPU forward-pass latency at 1080p INT8
        </h3>
        <p class="mb-4 max-w-prose-app text-base leading-relaxed text-foreground-secondary">
          Network-only inference, three Snapdragon generations. RIFE has to drop to 360p to even
          attempt the budget. ANVIL holds 1080p across two generations. Older HTP V69 silicon
          fails for everyone.
        </p>
        <div class="data-table-wrap mb-4">
          <table class="data-table">
            <thead>
              <tr>
                <th class="text-left">SoC</th>
                <th class="text-left">NPU</th>
                <th class="text-right">ANVIL-S</th>
                <th class="text-right">ANVIL-M</th>
                <th class="text-right">RIFE (360p)</th>
                <th class="text-center">&le; 33.3 ms</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-muted-foreground">SD 7+ Gen 2</td>
                <td class="font-mono text-xs text-muted-foreground">HTP V69</td>
                <td class="text-right font-mono text-muted-foreground">46.0 ms</td>
                <td class="text-right font-mono text-muted-foreground">56.6 ms</td>
                <td class="text-right font-mono text-muted-foreground">45.6 ms</td>
                <td class="text-center font-mono text-muted-foreground">&times;</td>
              </tr>
              <tr class="row-highlight">
                <td class="text-foreground">SD 8 Gen 2</td>
                <td class="font-mono text-xs text-foreground-secondary">HTP V73</td>
                <td class="text-right font-mono text-foreground">15.5 ms</td>
                <td class="text-right font-mono text-foreground">20.8 ms</td>
                <td class="text-right font-mono text-muted-foreground">20.7 ms</td>
                <td class="text-center font-mono text-accent">&check;</td>
              </tr>
              <tr class="row-highlight">
                <td class="text-foreground">SD 8 Gen 3</td>
                <td class="font-mono text-xs text-foreground-secondary">HTP V75</td>
                <td class="text-right font-mono text-foreground">12.8 ms</td>
                <td class="text-right font-mono text-foreground">16.7 ms</td>
                <td class="text-right font-mono text-muted-foreground">14.7 ms</td>
                <td class="text-center font-mono text-accent">&check;</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="max-w-prose-app text-sm leading-relaxed text-muted-foreground">
          On MediaTek (NeuroPilot Public SDK), ANVIL-S runs all operators APU-delegated at 1080p
          INT8: 24.4 ms on Dimensity 9300, 25.5 ms on Dimensity 9400+. The MediaTek path uses
          runtime compilation, so absolute timings aren&rsquo;t directly comparable to Qualcomm; the
          point is that the operator set is portable.
        </p>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight text-foreground">
          Quality vs. RIFE on Vimeo90K and Xiph 1080p
        </h3>
        <div class="data-table-wrap mb-4">
          <table class="data-table">
            <thead>
              <tr>
                <th class="text-left">Method</th>
                <th class="text-right">Params</th>
                <th class="text-right">Vimeo PSNR</th>
                <th class="text-right">Vimeo LPIPS</th>
                <th class="text-right">Xiph PSNR</th>
                <th class="text-left">Deployable?</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-muted-foreground">MV Blend (zero-param)</td>
                <td class="text-right font-mono text-muted-foreground">0</td>
                <td class="text-right font-mono text-muted-foreground">31.20</td>
                <td class="text-right font-mono text-muted-foreground">0.053</td>
                <td class="text-right font-mono text-muted-foreground">28.98</td>
                <td class="text-muted-foreground">&mdash;</td>
              </tr>
              <tr class="row-highlight">
                <td class="text-foreground">ANVIL-S</td>
                <td class="text-right font-mono text-foreground">855K</td>
                <td class="text-right font-mono text-foreground">33.45</td>
                <td class="text-right font-mono text-foreground">0.037</td>
                <td class="text-right font-mono text-foreground">29.65</td>
                <td class="font-mono text-xs text-accent">Yes</td>
              </tr>
              <tr class="row-highlight">
                <td class="text-foreground">ANVIL-M</td>
                <td class="text-right font-mono text-foreground">2.66M</td>
                <td class="text-right font-mono text-foreground">33.66</td>
                <td class="text-right font-mono text-foreground">0.036</td>
                <td class="text-right font-mono text-foreground">29.74</td>
                <td class="font-mono text-xs text-accent">Yes</td>
              </tr>
              <tr>
                <td class="text-muted-foreground">RIFE HDv3</td>
                <td class="text-right font-mono text-muted-foreground">3.04M</td>
                <td class="text-right font-mono text-muted-foreground">34.26</td>
                <td class="text-right font-mono text-muted-foreground">0.019</td>
                <td class="text-right font-mono text-muted-foreground">30.04</td>
                <td class="text-muted-foreground">No (grid_sample + INT8)</td>
              </tr>
              <tr>
                <td class="text-muted-foreground">NAFNet ceiling</td>
                <td class="text-right font-mono text-muted-foreground">17.1M</td>
                <td class="text-right font-mono text-muted-foreground">34.58</td>
                <td class="text-right font-mono text-muted-foreground">0.030</td>
                <td class="text-right font-mono text-muted-foreground">30.30</td>
                <td class="text-muted-foreground">No (LayerNorm)</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="max-w-prose-app text-sm leading-relaxed text-muted-foreground">
          ANVIL-M trails non-deployable RIFE by 0.6 dB PSNR on Vimeo and 0.3 dB on Xiph. LPIPS is
          worse (0.036 vs. 0.019), reflecting the smoothness bias of residual prediction versus
          sub-pixel warping. The NAFNet ceiling has the same gap, so it&rsquo;s a structural
          property of residual VFI rather than a capacity issue.
        </p>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight text-foreground">
          Visual comparison
        </h3>
        <figure class="figure-frame">
          <div class="figure-paper">
            <img
              src="/anvil/figures/qualitative.jpg"
              alt="Visual comparison of ANVIL-M, RIFE HDv3, and ground truth on three Xiph 1080p sequences"
              class="w-full"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
            <span class="font-medium text-foreground">Fig. 3 &mdash; Three failure modes on Xiph 1080p (3&times; insets).</span>
            <em>old_town_cross</em> (slow pan): ANVIL&rsquo;s smoothing suppresses noise (+0.7 dB
            vs. RIFE) but loses fine detail. <em>tractor</em> (large rigid motion): ANVIL
            over-smooths edges; RIFE produces ghosting. <em>riverbed</em> (stochastic texture):
            both paradigms collapse&mdash;non-rigid motion defeats both. The smoothness bias
            helps low-texture regions and hurts high-frequency detail.
          </figcaption>
        </figure>

        <h3 class="mt-10 mb-3 text-xl font-semibold tracking-tight text-foreground">
          Capacity scaling
        </h3>
        <figure class="figure-frame">
          <div class="figure-paper">
            <img
              src="/anvil/figures/scaling.png"
              alt="Vimeo90K PSNR vs. parameter count for ANVIL variants, RIFE HDv3, and NAFNet ceiling"
              class="mx-auto w-full max-w-xl"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
            <span class="font-medium text-foreground">Fig. 4 &mdash; PSNR vs. parameter count on Vimeo90K.</span>
            Quality scales smoothly with capacity from 1.8K to 2.66M params; smoothed prealignment
            shifts the entire curve up. ANVIL-S/M sit close to the RIFE HDv3 reference line at
            comparable parameter counts and trend toward the 17.1M NAFNet ceiling. The framework
            has not saturated.
          </figcaption>
        </figure>
      </section>

      <!-- The quantization story -->
      <section id="quantization" class="mb-14">
        <p class="section-eyebrow mb-4">Quantization Analysis</p>
        <div class="max-w-prose-app">
          <h2 class="mb-4 text-2xl font-semibold tracking-tight text-foreground">
            Why iterative flow methods break under INT8
          </h2>
        <div class="space-y-4 text-base leading-relaxed text-foreground-secondary">
          <p>
            INT8 post-training quantization usually loses fractions of a dB on classification and
            detection networks. On iterative flow VFI it loses 4 dB. Per-operator instrumentation
            on RIFE and IFRNet shows the failure follows the same pattern in both:
          </p>
          <ol class="ml-5 list-decimal space-y-2.5 pl-1 marker:font-mono marker:text-xs marker:text-muted-foreground">
            <li>
              Quantizing convolutions introduces a small initial error (CosSim drops 0.048 for
              RIFE, 0.055 for IFRNet). Acceptable.
            </li>
            <li>Quantizing PReLU adds zero further degradation. Benign.</li>
            <li>
              Quantizing <code class={inlineCode}>Add</code> triggers collapse. CosSim
              drops to 0.815 on RIFE and 0.878 on IFRNet. This is the only operator that matters.
            </li>
            <li>Full W8A8 &asymp; Conv + Add. Nothing else contributes meaningfully.</li>
          </ol>
          <p>
            The mechanism: iterative VFI accumulates flow as
            <code class={inlineCode}>f<sub>accum</sub> = f<sub>accum</sub> + &Delta;f</code>
            across stages. Each stage&rsquo;s quantized output feeds the next, and trained flow
            states have a wide dynamic range (&plusmn;19 px for RIFE, &plusmn;11 px for IFRNet)
            that doesn&rsquo;t fit cleanly in 8 bits. The error compounds.
          </p>
          <p>
            ANVIL avoids the trap by construction. There is no recurrent flow state, so no
            <code class={inlineCode}>Add</code>-on-recurrent-state to amplify. The
            residuals it does predict have range &plusmn;0.25, comfortably within INT8. There is
            no <code class={inlineCode}>grid_sample</code> on the NPU, so quantization
            noise can&rsquo;t bounce through a sampler. ANVIL-S loses 0.19 dB under INT8;
            ANVIL-M loses 0.09 dB.
          </p>
          </div>
        </div>
      </section>

      <!-- Components -->
      <section id="components" class="mb-14">
        <h2 class="section-eyebrow mb-5">Components</h2>
        <div class="max-w-prose-app divide-y divide-border-subtle border-y border-border-subtle">
          <div class="py-5">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h3 class="text-lg font-semibold tracking-tight text-foreground">
                <code class="font-mono">anvil</code>
              </h3>
              <a
                href="https://github.com/NihilDigit/anvil"
                target="_blank"
                rel="noopener"
                class="font-mono text-xs text-muted-foreground underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >
                github.com/NihilDigit/anvil &rarr;
              </a>
            </div>
            <p class="mt-2.5 text-base leading-relaxed text-foreground-secondary">
              Training and evaluation code for ANVIL-S and ANVIL-M, plus the ONNX export and INT8
              calibration pipeline. Includes the per-operator quantization instrumentation used to
              localize the iterative-flow collapse, the cross-vendor operator benchmark
              (Qualcomm HTP, MediaTek APU), and the comparative evaluations against RIFE and
              IFRNet on Vimeo90K and Xiph 1080p.
            </p>
          </div>
          <div class="py-5">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h3 class="text-lg font-semibold tracking-tight text-foreground">
                <code class="font-mono">mpv-android-anvil</code>
              </h3>
              <a
                href="https://github.com/NihilDigit/mpv-android-anvil"
                target="_blank"
                rel="noopener"
                class="font-mono text-xs text-muted-foreground underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >
                github.com/NihilDigit/mpv-android-anvil &rarr;
              </a>
            </div>
            <p class="mt-2.5 text-base leading-relaxed text-foreground-secondary">
              A fork of mpv-android that runs the full three-processor pipeline live: software
              H.264 decode (via FFmpeg, since Android&rsquo;s MediaCodec doesn&rsquo;t expose
              per-macroblock MVs), a Vulkan compute shader for smoothing and warp, and Qualcomm
              QNN/HTP for INT8 inference. Includes an A/B toggle for direct visual comparison and
              ships with four Xiph 1080p test sequences. The teaser at the top of this page is
              recorded from this player.
            </p>
          </div>
        </div>
      </section>

      <!-- Abstract -->
      <section id="abstract" class="mb-14">
        <h2 class="section-eyebrow mb-4">Abstract</h2>
        <p class="max-w-prose-app text-base leading-relaxed text-foreground-secondary">
          {anvil.data.abstract}
        </p>
      </section>

      <!-- Limitations -->
      <section id="limitations" class="mb-14">
        <h2 class="section-eyebrow mb-4">Limitations</h2>
        <div class="max-w-prose-app space-y-4 text-base leading-relaxed text-foreground-secondary">
          <p>
            ANVIL is built on a specific assumption: the decoder hands you motion vectors. Today
            that means H.264/AVC playback with software decoding through FFmpeg. Android&rsquo;s
            hardware MediaCodec path doesn&rsquo;t expose per-macroblock MVs, so the demo player
            uses libavcodec on the CPU. Generalization to HEVC and AV1, and to playback paths
            without decoder access, is left to future work.
          </p>
          <p>
            On the quality side, residual prediction is structurally smoother than sub-pixel
            warping. ANVIL&rsquo;s LPIPS is roughly 2&times; worse than RIFE&rsquo;s on Xiph
            1080p (0.148 vs. 0.077). The same gap appears in the 17.1M-parameter NAFNet ceiling,
            so it&rsquo;s a property of the paradigm, not of the model size. Perceptual-loss
            fine-tuning could partly close it, provided the result still survives INT8.
          </p>
          <p>
            Thermal throttling matters. The 28.4 ms median holds in the warm steady state
            (minutes 6&ndash;21 of a 30-minute playback); the hot phase (minutes 22&ndash;30)
            has an 11% frame-drop rate vs. 2&ndash;3% in steady state. A thermal-aware
            frame-skip policy is a reasonable mitigation.
          </p>
        </div>
      </section>

      <!-- BibTeX -->
      {
        anvil.data.bibtex && (
          <section id="bibtex" class="max-w-prose-app pt-2">
            <div class="surface-card overflow-hidden">
              <div class="flex items-center justify-between border-b border-border-subtle bg-surface-2/50 px-4 py-2.5">
                <h2 class="section-eyebrow-plain">BibTeX</h2>
                <button
                  type="button"
                  data-bibtex-copy
                  class="action-chip action-chip-sm"
                >
                  Copy
                </button>
              </div>
              <pre class="overflow-x-auto bg-code-bg p-4 text-xs leading-relaxed text-foreground-secondary sm:p-5"><code data-bibtex-text>{anvil.data.bibtex.trim()}</code></pre>
            </div>
          </section>
        )
      }
    </article>
  </main>
  <Footer />
</Layout>

<script>
  function initBibtexCopy() {
    const btn = document.querySelector<HTMLButtonElement>("[data-bibtex-copy]");
    const code = document.querySelector<HTMLElement>("[data-bibtex-text]");
    if (!btn || !code || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    const defaultLabel = "Copy";
    let resetTimer: number | undefined;

    btn.addEventListener("click", async () => {
      window.clearTimeout(resetTimer);
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        btn.textContent = "Copied";
        resetTimer = window.setTimeout(
          () => (btn.textContent = defaultLabel),
          1200
        );
      } catch {
        // Clipboard API unavailable (insecure context, old browsers).
        // Select the BibTeX so the user can finish the copy with Cmd/Ctrl+C.
        const range = document.createRange();
        range.selectNodeContents(code);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = "Selected: Cmd/Ctrl+C";
        resetTimer = window.setTimeout(
          () => (btn.textContent = defaultLabel),
          2400
        );
      }
    });
  }

  initBibtexCopy();
  document.addEventListener("astro:page-load", initBibtexCopy);
</script>
