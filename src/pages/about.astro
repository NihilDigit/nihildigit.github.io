---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HrefIcon from "@/components/HrefIcon.astro";
import { SITE } from "@/config";

const CONTACTS = [
  {
    href: "mailto:spencerliu@stu.ncst.edu.cn",
    label: "spencerliu@stu.ncst.edu.cn",
    note: "school",
  },
  {
    href: "mailto:starse.nd233@gmail.com",
    label: "starse.nd233@gmail.com",
    note: "personal",
  },
  { href: "https://github.com/NihilDigit", label: "@NihilDigit", note: "GitHub" },
  {
    href: "https://orcid.org/0009-0004-9426-3713",
    label: "0009-0004-9426-3713",
    note: "ORCID",
  },
  { href: "https://t.me/NihilDigit", label: "@NihilDigit", note: "Telegram" },
];
---

<Layout title={`About · ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-10 pb-20">
    <article class="max-w-prose-app">
      <header class="mb-12">
        <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          About
        </p>
        <div class="mt-3 flex flex-wrap items-start justify-between gap-x-6 gap-y-5">
          <div class="min-w-0 flex-1">
            <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
              NihilDigit
            </h1>
            <p class="mt-2 font-mono text-sm text-muted-foreground">Shibo Liu</p>
          </div>
          <a
            href="/Shibo_Liu_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="cv-peek group ml-auto inline-block shrink-0 self-start"
          >
            <span class="cv-peek__frame">
              <span class="cv-peek__paper">
                <span class="cv-peek__fold" aria-hidden="true"></span>
                <span class="cv-peek__label" aria-hidden="true">CV.pdf</span>
                <span class="cv-peek__title">View CV</span>
                <span class="sr-only">, PDF opens in a new tab</span>
                <span class="cv-peek__rule" aria-hidden="true"></span>
                <span class="cv-peek__rule cv-peek__rule--short" aria-hidden="true"></span>
              </span>
            </span>
          </a>
        </div>
      </header>

      <section class="space-y-6 text-foreground leading-relaxed">
        <p>
          I study intelligence science at
          <a
            href="https://www.ncst.edu.cn/"
            target="_blank"
            rel="noopener"
            class="underline decoration-dotted underline-offset-4 hover:text-accent"
          >North China University of Science and Technology</a>, where I
          enrolled in 2023. My work centers on on-device AI and multimedia
          systems.
        </p>

        <p>
          <a
            href="/anvil"
            class="underline decoration-dotted underline-offset-4 hover:text-accent"
          >ANVIL</a> is a video frame interpolation method designed for
          mobile NPUs. Flow-based interpolation breaks down under INT8
          quantization, so ANVIL reuses the motion vectors already produced
          by the H.264 decoder instead of learning optical flow. The arXiv
          preprint is public.
        </p>

        <p>
          <a
            href="/tongxing"
            class="underline decoration-dotted underline-offset-4 hover:text-accent"
          >TongXing</a> is an edge assistive system for blind and low-vision
          users, awarded a national second prize in 4C2026. It runs obstacle
          warning, offline speech, and a local LLM agent on a single phone,
          and the agent completes touch-first app tasks by voice.
        </p>

        <p>
          As a member of the
          <a
            href="https://github.com/open-ani"
            target="_blank"
            rel="noopener"
            class="underline decoration-dotted underline-offset-4 hover:text-accent"
          >open-ani</a> organization, I contribute to Animeko, an open-source
          anime player, across animeko, mediamp, and anitorrent. My work
          covers player and cross-platform support, and media acquisition.
        </p>

        <p>
          <a
            href="https://github.com/NihilDigit/piko"
            target="_blank"
            rel="noopener"
            class="underline decoration-dotted underline-offset-4 hover:text-accent"
          >piko</a> builds on the Kotlin Multiplatform experience from
          Animeko: a PikPak client for Android, Windows, and macOS, focused
          on network performance and on the design of its clip feed. Shortly
          after release it passed 100 stars and 2,000 downloads.
        </p>
      </section>

      <hr class="my-12 border-border" />

      <section>
        <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Education
        </h2>
        <dl class="grid grid-cols-[6rem_1fr] gap-x-6 gap-y-2 font-mono text-sm">
          <dt class="text-muted-foreground tabular-nums">2023 &ndash;</dt>
          <dd>
            B.S. in Intelligence Science<br />
            <span class="text-muted-foreground">
              College of Science, North China University of Science and
              Technology<br />
              Tangshan, Hebei, China
            </span>
          </dd>
        </dl>
      </section>

      <hr class="my-12 border-border" />

      <section>
        <h2 class="mb-5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Contact
        </h2>
        <ul class="space-y-2.5 font-mono text-sm">
          {
            CONTACTS.map(c => (
              <li class="flex flex-wrap items-center gap-x-3">
                <a
                  href={c.href}
                  target={c.href.startsWith("mailto:") ? undefined : "_blank"}
                  rel={c.href.startsWith("mailto:") ? undefined : "noopener"}
                  class="inline-flex items-center gap-2 transition-colors hover:text-accent"
                >
                  <HrefIcon href={c.href} class="size-4 shrink-0" />
                  <span class="underline decoration-dotted underline-offset-4">
                    {c.label}
                  </span>
                </a>
                <span class="text-xs text-muted-foreground">{c.note}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .cv-peek {
    position: relative;
    width: 7.4rem;
    height: 5.15rem;
    min-width: 44px;
    min-height: 44px;
    overflow: visible;
    perspective: 34rem;
    -webkit-tap-highlight-color: transparent;
  }

  .cv-peek__frame {
    position: relative;
    display: block;
    width: 7.4rem;
    height: 5.15rem;
    overflow: visible;
    clip-path: inset(-4.8rem -4.8rem 0 -4.8rem);
  }

  .cv-peek__paper {
    position: absolute;
    left: 1.25rem;
    top: 0.72rem;
    display: grid;
    width: 6.15rem;
    min-height: 7.55rem;
    align-content: start;
    gap: 0.34rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--background);
    padding: 0.78rem 0.68rem;
    color: var(--foreground);
    box-shadow: 0 0.7rem 1.5rem rgb(0 0 0 / 0.08);
    transform: translate3d(0, 0, 0) rotate(-4deg);
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 180ms ease,
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cv-peek:hover .cv-peek__paper,
  .cv-peek:focus-visible .cv-peek__paper {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0.95rem 1.9rem rgb(0 0 0 / 0.12);
    transform: translate3d(-1.2rem, -1.05rem, 0) rotate(-8deg);
  }

  .cv-peek:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 0.35rem;
  }

  .cv-peek__fold {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 1.35rem;
    height: 1.35rem;
    border-bottom: 1px solid var(--border);
    border-left: 1px solid var(--border);
    background: var(--muted);
    clip-path: polygon(100% 0, 0 0, 100% 100%);
    transition: border-color 180ms ease;
  }

  .cv-peek:hover .cv-peek__fold,
  .cv-peek:focus-visible .cv-peek__fold {
    border-color: var(--accent);
  }

  .cv-peek__label {
    width: fit-content;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 0.13rem 0.3rem;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.6rem;
    line-height: 1;
    color: var(--muted-foreground);
  }

  .cv-peek__title {
    margin-top: 0.5rem;
    font-size: 0.96rem;
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .cv-peek__rule {
    display: block;
    height: 1px;
    width: 100%;
    margin-top: 0.08rem;
    background: var(--border);
  }

  .cv-peek__rule--short {
    width: 62%;
    margin-top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-peek__paper {
      transition: border-color 180ms ease, color 180ms ease;
    }

    .cv-peek:hover .cv-peek__paper,
    .cv-peek:focus-visible .cv-peek__paper {
      transform: translate3d(0, 0, 0) rotate(-4deg);
    }
  }
</style>
