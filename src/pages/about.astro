---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HrefIcon from "@/components/HrefIcon.astro";
import { SITE } from "@/config";

const CONTACTS = [
  {
    href: "mailto:spencerliu@stu.ncst.edu.cn",
    label: "spencerliu@stu.ncst.edu.cn",
    note: "school",
  },
  {
    href: "mailto:starse.nd233@gmail.com",
    label: "starse.nd233@gmail.com",
    note: "personal",
  },
  { href: "https://github.com/NihilDigit", label: "@NihilDigit", note: "GitHub" },
  {
    href: "https://orcid.org/0009-0004-9426-3713",
    label: "0009-0004-9426-3713",
    note: "ORCID",
  },
  { href: "https://t.me/NihilDigit", label: "@NihilDigit", note: "Telegram" },
];
const inlineLink =
  "font-medium text-foreground underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent";
---

<Layout title={`About | ${SITE.title}`} schemaType="ProfilePage">
  <Header />
  <main id="main-content" class="app-layout pt-9 pb-20 sm:pt-11">
    <article class="max-w-prose-app">
      <header class="mb-10 border-b border-border-subtle pb-8">
        <p class="section-eyebrow-plain">About</p>
        <div class="mt-3 flex flex-wrap items-start justify-between gap-x-6 gap-y-5">
          <div class="min-w-0 flex-1">
            <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              NihilDigit
            </h1>
            <p class="mt-1.5 font-mono text-sm text-muted-foreground">Shibo Liu</p>
          </div>
          <a
            href="/Shibo_Liu_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="cv-peek group ml-auto inline-block shrink-0 self-start"
          >
            <span class="cv-peek__frame">
              <span class="cv-peek__paper">
                <span class="cv-peek__fold" aria-hidden="true"></span>
                <span class="cv-peek__label" aria-hidden="true">CV.pdf</span>
                <span class="cv-peek__title">View CV</span>
                <span class="sr-only">, PDF opens in a new tab</span>
                <span class="cv-peek__rule" aria-hidden="true"></span>
                <span class="cv-peek__rule cv-peek__rule--short" aria-hidden="true"></span>
              </span>
            </span>
          </a>
        </div>
      </header>

      <section class="space-y-5 text-base leading-relaxed text-foreground-secondary">
        <p>
          I study intelligence science at
          <a
            href="https://www.ncst.edu.cn/"
            target="_blank"
            rel="noopener"
            class={inlineLink}
          >North China University of Science and Technology</a>, where I
          enrolled in 2023. My work centers on on-device AI and multimedia
          systems.
        </p>

        <p>
          <a href="/anvil" class={inlineLink}>ANVIL</a> is a video frame
          interpolation method designed for mobile NPUs. Flow-based
          interpolation breaks down under INT8 quantization, so ANVIL reuses the
          motion vectors already produced by the H.264 decoder instead of
          learning optical flow. The arXiv preprint is public.
        </p>

        <p>
          <a href="/tongxing" class={inlineLink}>TongXing</a> is an edge
          assistive system for blind and low-vision users, awarded a national
          second prize in 4C2026. It runs obstacle warning, offline speech, and
          a local LLM agent on a single phone, and the agent completes
          touch-first app tasks by voice.
        </p>

        <p>
          <a
            href="https://github.com/NihilDigit/piko"
            target="_blank"
            rel="noopener"
            class={inlineLink}
          >piko</a> is an independent PikPak client I build and maintain for
          Android, Windows, and macOS. It has been my main place to run
          experiments on UI/UX and client architecture, from the clip feed to
          transfer and playback pipelines, while user feedback across releases
          has built up practical experience in maintaining a complex system.
        </p>

        <p>
          As a member of the
          <a
            href="https://github.com/open-ani"
            target="_blank"
            rel="noopener"
            class={inlineLink}
          >open-ani</a> organization, I contribute to Animeko, an open-source
          anime player, across animeko, mediamp, and anitorrent. My work covers
          player and cross-platform support, and media acquisition.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="section-eyebrow mb-5">Education</h2>
        <dl class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:items-baseline">
          <dt class="font-mono text-sm tabular-nums text-muted-foreground">
            2023 &ndash;
          </dt>
          <dd class="text-sm leading-relaxed">
            <span class="font-medium text-foreground">B.S. in Intelligence Science</span>
            <span class="mt-0.5 block text-foreground-secondary">
              College of Science, North China University of Science and Technology
            </span>
            <span class="mt-0.5 block font-mono text-xs text-muted-foreground">
              Tangshan, Hebei, China
            </span>
          </dd>
        </dl>
      </section>

      <section class="mt-12">
        <h2 class="section-eyebrow mb-4">Contact</h2>
        <ul class="divide-y divide-border-subtle border-y border-border-subtle font-mono text-sm">
          {
            CONTACTS.map(c => (
              <li class="grid grid-cols-1 gap-x-4 gap-y-0.5 py-2.5 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-center">
                <span class="text-xs text-muted-foreground">{c.note}</span>
                <a
                  href={c.href}
                  target={c.href.startsWith("mailto:") ? undefined : "_blank"}
                  rel={c.href.startsWith("mailto:") ? undefined : "noopener"}
                  class="group/contact inline-flex max-w-full min-w-0 w-fit items-center gap-2 text-foreground transition-colors hover:text-accent"
                >
                  <HrefIcon
                    href={c.href}
                    class="size-4 shrink-0 text-muted-foreground transition-colors group-hover/contact:text-accent"
                  />
                  <span class="break-all underline decoration-border decoration-dotted underline-offset-4 transition-colors group-hover/contact:decoration-accent sm:break-normal">
                    {c.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .cv-peek {
    position: relative;
    width: 7.4rem;
    height: 5.15rem;
    min-width: 44px;
    min-height: 44px;
    overflow: visible;
    perspective: 34rem;
    -webkit-tap-highlight-color: transparent;
  }

  .cv-peek__frame {
    position: relative;
    display: block;
    width: 7.4rem;
    height: 5.15rem;
    overflow: visible;
    clip-path: inset(-4.8rem -4.8rem 0 -4.8rem);
  }

  .cv-peek__paper {
    position: absolute;
    left: 1.25rem;
    top: 0.72rem;
    display: grid;
    width: 6.15rem;
    min-height: 7.55rem;
    align-content: start;
    gap: 0.34rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--surface-1);
    padding: 0.78rem 0.68rem;
    color: var(--foreground);
    box-shadow:
      0 0.7rem 1.5rem rgb(0 0 0 / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.04);
    transform: translate3d(0, 0, 0) rotate(-4deg);
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cv-peek:hover .cv-peek__paper,
  .cv-peek:focus-visible .cv-peek__paper {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow:
      0 0.95rem 1.95rem rgb(0 0 0 / 0.14),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    transform: translate3d(-1.2rem, -1.05rem, 0) rotate(-8deg);
  }

  .cv-peek:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 0.35rem;
  }

  .cv-peek__fold {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 1.35rem;
    height: 1.35rem;
    border-bottom: 1px solid var(--border);
    border-left: 1px solid var(--border);
    background: var(--surface-2);
    clip-path: polygon(100% 0, 0 0, 100% 100%);
    transition: border-color 180ms ease;
  }

  .cv-peek:hover .cv-peek__fold,
  .cv-peek:focus-visible .cv-peek__fold {
    border-color: var(--accent);
  }

  .cv-peek__label {
    width: fit-content;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--background);
    padding: 0.13rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1;
    color: var(--muted-foreground);
  }

  .cv-peek__title {
    margin-top: 0.5rem;
    font-size: 0.96rem;
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .cv-peek__rule {
    display: block;
    height: 1px;
    width: 100%;
    margin-top: 0.08rem;
    background: var(--border);
  }

  .cv-peek__rule--short {
    width: 62%;
    margin-top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-peek__paper {
      transition:
        border-color 180ms ease,
        background-color 180ms ease,
        color 180ms ease;
    }

    .cv-peek:hover .cv-peek__paper,
    .cv-peek:focus-visible .cv-peek__paper {
      transform: translate3d(0, 0, 0) rotate(-4deg);
    }
  }
</style>
