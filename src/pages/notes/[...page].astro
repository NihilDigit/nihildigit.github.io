---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("notes", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={`Notes archive · ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-10 pb-20">
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
        Archived
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Notes
      </h1>
      <p class="mt-3 max-w-prose-app text-muted-foreground">
        Old reading and study notes from early 2024. Kept for archive only —
        not actively maintained.
      </p>
    </header>

    <ul class="divide-y divide-border border-y border-border">
      {
        page.data.map(post => (
          <li>
            <a
              href={`/notes/${post.id}/`}
              class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6"
            >
              <span class="font-mono text-xs tabular-nums text-muted-foreground sm:w-28 sm:shrink-0">
                {fmtDate(post.data.pubDatetime)}
              </span>
              <span class="flex-1 text-sm font-medium transition-colors group-hover:text-accent">
                {post.data.title}
              </span>
              <span class="badge badge-archived sm:shrink-0">
                <span class="badge-dot" />
                archived
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
