---
import { getCollection, getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/octicons/arrow-right-16.svg";
import AnvilTeaser from "@/components/AnvilTeaser.astro";
import ContributionRow from "@/components/ContributionRow.astro";
import KeyNumbers from "@/components/KeyNumbers.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";
import IconGitHub from "@/assets/icons/octicons/mark-github-16.svg";
import HrefIcon from "@/components/HrefIcon.astro";
import { paperStatusClass, paperStatusLabel } from "@/utils/paperStatus";
import { getGitHubReleaseDownloads, getGitHubRepoStats } from "@/utils/githubStats";
import { resolveFeaturedCollection } from "@/utils/featuredContributions";

const anvil = await getEntry("papers", "anvil");

const allFeatured = await resolveFeaturedCollection(await getCollection("featured"));
const sortedFeatured = allFeatured.sort((a, b) => a.data.order - b.data.order);
const ANVIL_REPO = "NihilDigit/anvil";
const featuredRepoStats = await getGitHubRepoStats(
  sortedFeatured.map(entry => entry.data.repo).filter(repo => repo !== undefined)
);
const featuredDownloads = new Map(
  await Promise.all(
    sortedFeatured
      .filter(entry => entry.data.showDownloads && entry.data.repo)
      .map(async entry => [entry.id, await getGitHubReleaseDownloads(entry.data.repo!)] as const)
  )
);

const starsOf = (entry: (typeof sortedFeatured)[number]) =>
  (entry.data.repo ? featuredRepoStats.get(entry.data.repo)?.stars : undefined) ??
  entry.data.fallbackStars;

const upstream = await getCollection("upstream");

const allPapers = await getCollection("papers");
const sortedPapers = allPapers.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const fmtAuthors = (authors: { name: string; isMe?: boolean }[]) =>
  authors
    .map(a => (a.isMe ? `<strong class="text-foreground">${a.name}</strong>` : a.name))
    .join(", ");

---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- Featured: ANVIL -->
    <section id="featured-anvil" class="py-10" data-reveal>
      <div>
        <div>
          <h3 class="max-w-4xl text-2xl font-semibold tracking-tight sm:text-3xl">
            <a
              href={`https://github.com/${ANVIL_REPO}`}
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-accent"
            >
              <IconGitHub class="mr-2 inline-block h-[0.85em] w-[0.85em] align-[-0.07em]" />
              {anvil?.data.title}
            </a>
          </h3>

          <div class="mt-5 grid gap-5 md:grid-cols-2">
            {anvil?.data.teaserVideo && (
              <AnvilTeaser
                src={anvil.data.teaserVideo}
                poster={anvil.data.teaserPoster}
                priority
              />
            )}

            {/* Stretched to the video's height so the buttons sit on its bottom edge. */}
            <div class="flex flex-col justify-between">
              <p class="text-foreground/80">{anvil?.data.tldr}</p>

              <div class="mt-5 flex flex-wrap justify-end gap-2">
                <a href="/anvil" class="action-chip action-chip-primary">
                  Read project page
                  <IconArrowRight class="size-4 shrink-0" />
                </a>
                {anvil?.data.links
                  // The project page lists code, demo, and APK; the card keeps only the paper.
                  .filter(l => l.label === "arXiv")
                  .map(l => (
                  <a href={l.href} target="_blank" rel="noopener" class="action-chip">
                    <HrefIcon href={l.href} class="size-4 shrink-0" />
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          </div>

          {anvil?.data.keyNumbers && <KeyNumbers items={anvil.data.keyNumbers} />}
        </div>
      </div>
    </section>

    <!-- Featured: the rest, from the featured collection -->
    {sortedFeatured.map(entry => <FeaturedCard
        entry={entry}
        stars={starsOf(entry)}
        downloads={featuredDownloads.get(entry.id)}
      />)}

    <!-- Upstream contributions: small patches outside the featured projects -->
    <section id="upstream" class="border-t border-border py-10" data-reveal>
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Upstream contributions
        </h2>
      </div>

      <ol class="max-w-4xl divide-y divide-border/70">
        {upstream.map(u => (
          <ContributionRow
            item={{
              ...u.data,
              label: `${u.data.project}: ${u.data.label}`,
            }}
          />
        ))}
      </ol>
    </section>

    <!-- Publications -->
    <section id="publications" class="border-t border-border pt-10 pb-16" data-reveal>
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Publications
        </h2>
      </div>

      <ul class="divide-y divide-border/70">
        {
          sortedPapers.map(p => (
            <li class="grid gap-x-4 gap-y-2 py-3 sm:grid-cols-[3.25rem_minmax(0,1fr)_auto] sm:items-baseline">
              <span class="font-mono text-xs tabular-nums text-muted-foreground">
                {p.data.year}
              </span>

              <div class="min-w-0">
                <h3 class="text-base font-medium leading-snug">
                  {p.data.hasProjectPage && p.data.projectPageSlug ? (
                    <a
                      href={`/${p.data.projectPageSlug}`}
                      class="transition-colors hover:text-accent"
                    >
                      {p.data.title}
                    </a>
                  ) : (
                    p.data.title
                  )}
                </h3>
                <p
                  class="mt-1 text-sm text-muted-foreground"
                  set:html={fmtAuthors(p.data.authors)}
                />
                <p class="mt-0.5 flex flex-wrap items-center gap-x-2 font-mono text-xs text-muted-foreground">
                  <span class={paperStatusClass(p.data.status)}>
                    {paperStatusLabel(p.data.status)}
                  </span>
                  <span aria-hidden>·</span>
                  <span>{p.data.venue}</span>
                </p>
              </div>

              {p.data.links && p.data.links.length > 0 && (
                <span class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs sm:justify-end">
                  {p.data.links.slice(0, 2).map(l => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-accent"
                    >
                      <HrefIcon href={l.href} />
                      <span class="underline decoration-dotted underline-offset-4">
                        {l.label}
                      </span>
                    </a>
                  ))}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initContributionSort() {
    document
      .querySelectorAll<HTMLElement>("[data-contribution-sort]")
      .forEach(controls => {
        if (controls.dataset.bound === "true") return;
        controls.dataset.bound = "true";

        const list = controls
          .closest("section")
          ?.querySelector<HTMLOListElement>("[data-contribution-list]");
        if (!list) return;

        const buttons = controls.querySelectorAll<HTMLButtonElement>(
          "[data-sort-by]"
        );
        buttons.forEach(button => {
          button.addEventListener("click", () => {
            const key = button.dataset.sortBy === "time" ? "time" : "lines";
            const items = Array.from(
              list.querySelectorAll<HTMLElement>("li[data-lines]")
            );
            items
              .sort(
                (a, b) =>
                  Number(b.dataset[key] ?? 0) - Number(a.dataset[key] ?? 0)
              )
              .forEach(item => list.append(item));

            // Styling hangs off aria-pressed in CSS, so the state lives in
            // exactly one place.
            buttons.forEach(b =>
              b.setAttribute("aria-pressed", String(b === button))
            );
          });
        });
      });
  }

  initContributionSort();
  document.addEventListener("astro:page-load", initContributionSort);

  // Rows wrap to different heights on narrow screens, so a fixed max-height
  // shows a different number of rows per width. The class max-height stays as
  // the no-JS fallback; this measures the first N rows and overrides it.
  function fitVisibleRows(box: HTMLElement) {
    const count = Number(box.dataset.visibleRows);
    const rows = box.querySelectorAll<HTMLElement>("li[data-lines]");
    const last = rows[Math.min(count, rows.length) - 1];
    if (!last) return;
    const height =
      last.getBoundingClientRect().bottom - box.getBoundingClientRect().top;
    box.style.maxHeight = `${Math.ceil(height + box.scrollTop)}px`;
  }

  function initVisibleRows() {
    document
      .querySelectorAll<HTMLElement>("[data-visible-rows]")
      .forEach(box => {
        if (box.dataset.bound === "true") return;
        box.dataset.bound = "true";
        fitVisibleRows(box);
        new ResizeObserver(() => fitVisibleRows(box)).observe(
          box.querySelector("ol") ?? box
        );
        // Sorting reorders rows without resizing the list, so the observer
        // does not fire; the leading rows may now have different heights.
        new MutationObserver(() => fitVisibleRows(box)).observe(
          box.querySelector("ol") ?? box,
          { childList: true }
        );
      });
  }

  initVisibleRows();
  document.addEventListener("astro:page-load", initVisibleRows);

  function initReveal() {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (!targets.length) return;

    if (!("IntersectionObserver" in window)) {
      targets.forEach(t => t.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
    );

    targets.forEach(t => {
      t.classList.add("reveal");
      observer.observe(t);
    });
  }

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
