---
import { getCollection, getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import AnvilTeaser from "@/components/AnvilTeaser.astro";
import { inlineCode } from "@/utils/inlineCode";
import { formatStars, getGitHubRepoStats } from "@/utils/githubStats";

const anvil = await getEntry("papers", "anvil");

const allFeatured = await getCollection("featured");
const sortedFeatured = allFeatured.sort((a, b) => a.data.order - b.data.order);
const featuredRepoStats = await getGitHubRepoStats(
  sortedFeatured.map(entry => entry.data.repo).filter(repo => repo !== undefined)
);

const allProjects = await getCollection("projects");
const spotlightProjects = allProjects
  .filter(p => p.data.spotlight)
  .sort((a, b) => a.data.order - b.data.order);

const allPapers = await getCollection("papers");
const sortedPapers = allPapers.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const fmtAuthors = (authors: { name: string; isMe?: boolean }[]) =>
  authors
    .map(a => (a.isMe ? `<strong class="text-foreground">${a.name}</strong>` : a.name))
    .join(", ");

const padIdx = (n: number) => String(n).padStart(2, "0");

const contributionStatusLabel = {
  done: "Merged",
  active: "Active",
  planned: "Planned",
  closed: "Closed",
} as const;

const splitDiffstat = (diffstat: string) =>
  diffstat.match(/^(\+[^/]+)(\/)(-.+)$/);

const inlineLinks = (text: string) =>
  text.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-4 hover:text-accent">$1</a>'
  );

const isExternalHref = (href: string) => /^https?:\/\//.test(href);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- Hero -->
    <section id="hero" class="pt-12 pb-16 sm:pt-20 sm:pb-24">
      <h1 class="hero-rise text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
        I build systems.<br class="hidden sm:inline" />
        Useful, interesting, or efficient —<br class="hidden sm:inline" />
        <span class="text-accent">ideally all three</span>.
      </h1>
      <p class="hero-rise hero-rise-1 mt-6 font-mono text-sm text-muted-foreground">
        Undergrad &apos;23 · AI ·
        <a
          href="https://www.ncst.edu.cn/"
          target="_blank"
          rel="noopener"
          class="underline decoration-dotted underline-offset-4 hover:text-accent"
        >NCST</a>
      </p>

      <div class="hero-rise hero-rise-2 mt-8 flex flex-wrap items-center gap-3">
        <a
          href="mailto:spencerliu@stu.ncst.edu.cn"
          class="inline-flex items-baseline gap-2 rounded-md border border-border bg-muted/30 px-3.5 py-2 text-sm transition-colors hover:border-accent hover:text-accent"
        >
          <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
            School email
          </span>
          <span class="font-mono">spencerliu@stu.ncst.edu.cn</span>
        </a>
        <Socials />
      </div>
    </section>

    <!-- Featured · 01 — Research (ANVIL) -->
    <section id="featured-anvil" class="border-t border-border pt-10 pb-16">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Featured · 01 — Research
        </h2>
        <a href="/anvil" class="text-xs text-muted-foreground hover:text-accent">
          Project page →
        </a>
      </div>

      <div class="space-y-6">
        {anvil?.data.teaserVideo && (
          <AnvilTeaser
            src={anvil.data.teaserVideo}
            poster={anvil.data.teaserPoster}
            priority
          />
        )}

        <div>
          <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
            <a
              href="https://github.com/NihilDigit/anvil"
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-accent"
            >
              {anvil?.data.title}
            </a>
          </h3>
          <div class="badge badge-live mt-3">
            <span class="badge-dot" />
            <span>Submitted to</span>
            {anvil?.data.venueHref ? (
              <a
                href={anvil.data.venueHref}
                target="_blank"
                rel="noopener"
                class="underline decoration-dotted underline-offset-4 transition-colors hover:text-accent"
              >
                {anvil.data.venue}
              </a>
            ) : (
              anvil?.data.venue
            )}
          </div>
          <p class="mt-4 max-w-prose-app text-foreground/80">{anvil?.data.tldr}</p>

          {anvil?.data.keyNumbers && (
            <dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {anvil.data.keyNumbers.map(n => (
                <div class="border-t border-border pt-3">
                  <dt class="metric-value text-2xl text-foreground">{n.value}</dt>
                  <dd class="mt-1 text-xs text-muted-foreground">{n.caption}</dd>
                </div>
              ))}
            </dl>
          )}

          <div class="mt-6 flex flex-wrap gap-2">
            <a
              href="/anvil"
              class="inline-flex items-center gap-1.5 rounded-md bg-foreground px-3.5 py-1.5 text-sm font-medium text-background hover:bg-accent hover:text-accent-foreground"
            >
              Read project page →
            </a>
            {anvil?.data.links
              .filter(l => !l.label.includes("APK") && l.label !== "Training Code")
              .map(l => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-md border border-border px-3.5 py-1.5 text-sm font-mono hover:border-accent hover:text-accent"
              >
                {l.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Featured · 02..N — from featured collection -->
    {
      sortedFeatured.map((entry, i) => {
        const repoStats = entry.data.repo
          ? featuredRepoStats.get(entry.data.repo)
          : undefined;
        const stars = repoStats?.stars ?? entry.data.fallbackStars;

        return (
        <section
          id={`featured-${entry.id}`}
          class="border-t border-border pt-10 pb-16"
        >
          <div class="mb-6 flex items-baseline justify-between">
            <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
              Featured · {padIdx(i + 2)}
              {entry.data.eyebrow && (
                <span>
                  {" "}
                  —{" "}
                  {entry.data.eyebrowHref ? (
                    <a
                      href={entry.data.eyebrowHref}
                      target="_blank"
                      rel="noopener"
                      class="underline decoration-dotted underline-offset-4 transition-colors hover:text-accent"
                    >
                      {entry.data.eyebrow}
                    </a>
                  ) : (
                    entry.data.eyebrow
                  )}
                </span>
              )}
            </h2>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
            <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {entry.data.titleHref ? (
                <a
                  href={entry.data.titleHref}
                  target={isExternalHref(entry.data.titleHref) ? "_blank" : undefined}
                  rel={isExternalHref(entry.data.titleHref) ? "noopener" : undefined}
                  class="transition-colors hover:text-accent"
                >
                  {entry.data.title}
                </a>
              ) : (
                entry.data.title
              )}
            </h3>

            {stars !== undefined && (
              <span class="inline-flex items-baseline gap-1 font-mono text-sm text-muted-foreground">
                <span aria-hidden class="text-foreground/80">
                  ★
                </span>
                <span>{formatStars(stars)}</span>
              </span>
            )}
          </div>

          {entry.data.status && (
            <span
              class:list={[
                "badge mt-3",
                entry.data.statusVariant === "in-progress" && "badge-progress",
                entry.data.statusVariant === "live" && "badge-live",
                entry.data.statusVariant === "archived" && "badge-archived",
              ]}
            >
              <span class="badge-dot" />
              {entry.data.status}
              {entry.data.statusLink && (
                <a
                  href={entry.data.statusLink.href}
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-dotted underline-offset-4 transition-colors hover:text-accent"
                >
                  {entry.data.statusLink.label}
                </a>
              )}
            </span>
          )}

          {entry.data.metaTags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-xs text-muted-foreground">
              {entry.data.metaTags.map(t => (
                <li class="before:mr-2 before:content-['·'] before:text-muted-foreground/40 first:before:hidden">
                  {t}
                </li>
              ))}
            </ul>
          )}

          <p class="mt-4 max-w-prose-app text-foreground/80">{entry.data.summary}</p>

          {entry.data.contributions.length > 0 && (
            <ol class="mt-6 max-w-3xl divide-y divide-border border-y border-border">
              {entry.data.contributions.map(item => {
                const diffstat = splitDiffstat(item.diffstat);

                return (
                  <li class="grid gap-3 py-4 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-start">
                    <span class="font-mono text-xs leading-6 text-muted-foreground sm:text-right">
                      {diffstat ? (
                        <>
                          <span class="text-emerald-700/80 dark:text-emerald-300/80">
                            {diffstat[1]}
                          </span>
                          <span class="text-muted-foreground/50">{diffstat[2]}</span>
                          <span class="text-rose-700/75 dark:text-rose-300/75">
                            {diffstat[3]}
                          </span>
                        </>
                      ) : (
                        item.diffstat
                      )}
                    </span>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <span class="text-sm font-medium text-foreground">
                          {item.label}
                        </span>
                        <span
                          class:list={[
                            "font-mono text-[0.65rem] uppercase leading-none tracking-widest",
                            item.status === "done" &&
                              "text-accent",
                            item.status === "active" &&
                              "text-muted-foreground",
                            item.status === "planned" &&
                              "text-muted-foreground",
                            item.status === "closed" &&
                              "text-muted-foreground",
                          ]}
                        >
                          {contributionStatusLabel[item.status]}
                        </span>
                        {item.links.length > 0 && (
                          <span class="flex flex-wrap gap-1.5">
                            {item.links.map(link => (
                              <>
                                <a
                                  href={link.href}
                                  target="_blank"
                                  rel="noopener"
                                  class="inline-flex items-center gap-1 rounded-md border border-border px-2 py-0.5 font-mono text-[0.7rem] leading-5 text-muted-foreground transition-colors hover:border-accent hover:text-accent"
                                >
                                  {link.label} ↗
                                </a>
                              </>
                            ))}
                          </span>
                        )}
                      </div>
                      <p
                        class="mt-1 text-sm leading-relaxed text-foreground/80"
                        set:html={inlineLinks(item.detail)}
                      />
                    </div>
                  </li>
                );
              })}
            </ol>
          )}

          {entry.data.badges.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.data.badges.map(b =>
                b.label ? (
                  b.href ? (
                <a
                  href={b.href}
                  target={isExternalHref(b.href) ? "_blank" : undefined}
                  rel={isExternalHref(b.href) ? "noopener" : undefined}
                  class="font-mono text-xs text-muted-foreground underline decoration-dotted underline-offset-4 transition-colors hover:text-accent"
                >
                  {b.label}{isExternalHref(b.href) ? " ↗" : ""}
                </a>
                  ) : (
                    <span class="font-mono text-xs text-muted-foreground">
                      {b.label}
                    </span>
                  )
                ) : b.href && b.src ? (
                  <a
                    href={b.href}
                    target={isExternalHref(b.href) ? "_blank" : undefined}
                    rel={isExternalHref(b.href) ? "noopener" : undefined}
                    aria-label={b.alt}
                  >
                    <img src={b.src} alt={b.alt ?? ""} class="h-5" />
                  </a>
                ) : b.src ? (
                  <img src={b.src} alt={b.alt ?? ""} class="h-5" />
                ) : (
                  null
                )
              )}
            </div>
          )}

          <div class="mt-6 flex flex-wrap gap-2">
            {entry.data.links.map(l => (
              <a
                href={l.href}
                target={isExternalHref(l.href) ? "_blank" : undefined}
                rel={isExternalHref(l.href) ? "noopener" : undefined}
                class="inline-flex items-center gap-1.5 rounded-md border border-border px-3.5 py-1.5 text-sm font-mono hover:border-accent hover:text-accent"
              >
                {l.label}
                {isExternalHref(l.href) && <span aria-hidden>↗</span>}
              </a>
            ))}
          </div>
        </section>
        );
      })
    }

    <!-- Selected Open Source -->
    {spotlightProjects.length > 0 && (
      <section id="selected-oss" class="border-t border-border pt-10 pb-16">
        <div class="mb-8 flex items-baseline justify-between">
          <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
            Selected Open Source
          </h2>
          <a href="/projects" class="text-xs text-muted-foreground hover:text-accent">
            All projects →
          </a>
        </div>

        <ul class="space-y-10">
          {spotlightProjects.map(p => (
            <li class="max-w-prose-app">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <a
                  href={`https://github.com/${p.data.repo}`}
                  target="_blank"
                  rel="noopener"
                  class="font-mono text-lg font-medium transition-colors hover:text-accent break-all"
                >
                  {p.data.name}
                </a>
                <span class="font-mono text-xs text-muted-foreground">
                  {p.data.language}
                  {p.data.license && <> · {p.data.license}</>}
                </span>
              </div>
              <a
                href={`https://github.com/${p.data.repo}`}
                target="_blank"
                rel="noopener"
                class="font-mono text-xs text-muted-foreground transition-colors hover:text-accent"
              >
                github.com/{p.data.repo} ↗
              </a>
              <p
                class="mt-3 text-sm leading-relaxed text-foreground/80"
                set:html={inlineCode(p.data.description)}
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Publications -->
    <section id="publications" class="border-t border-border pt-10 pb-20">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Publications
        </h2>
        <a href="/papers" class="text-xs text-muted-foreground hover:text-accent">
          All publications →
        </a>
      </div>

      <ul class="space-y-6">
        {
          sortedPapers.map(p => (
            <li>
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-xs text-muted-foreground tabular-nums">
                  {p.data.year}
                </span>
                {p.data.status === "under-review" && (
                  <span class="font-mono text-xs uppercase tracking-wide text-emerald-700 dark:text-emerald-400">
                    Under review
                  </span>
                )}
                {p.data.status === "preprint" && (
                  <span class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
                    Preprint
                  </span>
                )}
                {p.data.status === "published" && (
                  <span class="font-mono text-xs uppercase tracking-wide text-emerald-600 dark:text-emerald-400">
                    Published
                  </span>
                )}
              </div>
              <h3 class="mt-1 text-base font-medium leading-snug">
                {p.data.hasProjectPage && p.data.projectPageSlug ? (
                  <a href={`/${p.data.projectPageSlug}`} class="hover:text-accent">
                    {p.data.title}
                  </a>
                ) : (
                  p.data.title
                )}
              </h3>
              <p
                class="mt-1 text-sm text-muted-foreground"
                set:html={fmtAuthors(p.data.authors)}
              />
              <p class="font-mono text-xs text-muted-foreground">{p.data.venue}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
