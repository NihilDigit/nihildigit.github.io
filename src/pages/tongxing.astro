---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HrefIcon from "@/components/HrefIcon.astro";
import ProjectVideo from "@/components/ProjectVideo.astro";
import ScrollableRow from "@/components/ScrollableRow.astro";

const projectLinks = [
  {
    label: "Code",
    href: "https://github.com/NihilDigit/tongxing",
  },
  {
    label: "Certificate",
    href: "/tongxing/4c2026-certificate.pdf",
  },
];

const safetyDemos = [
  {
    title: "Non-standard obstacle",
    src: "/tongxing/videos/pole.mp4",
    poster: "/tongxing/posters/pole.jpg",
    caption:
      "A pole-like obstacle missed by detection is recovered through segmentation.",
  },
  {
    title: "Street walking",
    src: "/tongxing/videos/street.mp4",
    poster: "/tongxing/posters/street.jpg",
    caption:
      "Static roadside objects stay quiet while approaching pedestrians are upgraded.",
  },
  {
    title: "Crowded pedestrian flow",
    src: "/tongxing/videos/pedestrian.mp4",
    poster: "/tongxing/posters/pedestrian.jpg",
    caption:
      "Multi-target tracking keeps object identities stable, so warnings do not flicker on every noisy frame.",
  },
];

const closedLoopGaps = [
  {
    title: "Perception",
    copy: "A cane only covers near-ground contact. Hanging signs, poles, parked vehicles, and crossing traffic remain outside its sensing range.",
  },
  {
    title: "Risk",
    copy: "Binary obstacle signals do not tell the user what the object is, whether it is approaching, or how urgently to react.",
  },
  {
    title: "Latency",
    copy: "Cloud vision can describe scenes, but 377-1300+ ms is too slow for collision warnings during walking.",
  },
  {
    title: "App access",
    copy: "Navigation, ride-hailing, ticket queries, weather, and visual description are scattered across touch-first apps that are hard to close through speech alone.",
  },
];

const edgeRationale = [
  {
    title: "Compute is already in the phone",
    copy: "Affordable Android phones increasingly ship with NPUs and GPUs that sit idle for most daily tasks. Assistive perception is a good use for that local compute.",
  },
  {
    title: "No extra hardware changes adoption",
    copy: "The marginal deployment cost is close to zero when the system reuses a phone and Bluetooth earphones instead of requiring smart glasses or a special cane.",
  },
  {
    title: "Local is the right safety boundary",
    copy: "Obstacle warning should not depend on uplink latency, coverage, or server availability. Keeping the safety path on device also keeps camera data local.",
  },
  {
    title: "Agentic UI is an accessibility layer",
    copy: "A tool-using voice agent can close touch-first app tasks through spoken workflows, as long as MCP tools and accessibility actions give the small local model a constrained control surface.",
  },
];

const designPrinciples = [
  {
    title: "No extra hardware",
    copy: "Chest-mounted phone, Bluetooth earphones, no smart glasses, no electronic cane dependency.",
  },
  {
    title: "Safety stays local",
    copy: "Obstacle warning, ASR, and TTS keep running in tunnels, elevators, and weak-signal areas.",
  },
  {
    title: "Cloud is optional",
    copy: "Scene description can call a cloud vision model, but the safety path does not depend on it.",
  },
];

const engineeringJudgments = [
  {
    title: "Post-fusion over joint training",
    copy: "YOLOX, MiDaS, and FFNet stay independently quantized and replaceable. The cost is more fusion code; the benefit is a deployable pipeline without a custom training set.",
  },
  {
    title: "Agent design before prompting",
    copy: "A 1.7B model is not asked to copy long POI IDs, inspect raw service schemas, or operate arbitrary screens directly. ComboTool, short LID mapping, OutputDistiller, Stem Context, and accessibility actions reduce the task before prompting begins.",
  },
  {
    title: "Hardware isolation over raw peak speed",
    copy: "Vision runs on Hexagon NPU, Qwen3-1.7B runs on Adreno GPU, and offline speech stays on CPU. The design protects the 15 Hz safety loop while the assistant is thinking.",
  },
];

const modelDeployments = [
  {
    unit: "Hexagon NPU",
    workload: "YOLOX, MiDaS, FFNet, MobileNetV2",
    detail: "W8A8 TFLite models handle detection, depth, segmentation, and tracking features.",
  },
  {
    unit: "Adreno GPU",
    workload: "Qwen3-1.7B",
    detail: "Q4_0 GGUF runs through a llama.cpp OpenCL backend, isolated from the vision path.",
  },
  {
    unit: "CPU",
    workload: "Paraformer ASR, TTS, fusion glue",
    detail: "Offline speech and lightweight control code keep the service usable without network.",
  },
];

const safetyPipeline = [
  {
    title: "Scale recovery",
    copy: "MiDaS gives relative depth, so SafetyCore uses chest-mounted camera geometry and FFNet ground pixels to recover a usable scene scale.",
  },
  {
    title: "Dual-path extraction",
    copy: "YOLOX covers people and vehicles. FFNet adds poles, fences, walls, and other non-standard obstacles that object detection misses.",
  },
  {
    title: "Tracking first",
    copy: "DeepSORT-style association keeps identities stable before any warning is spoken, so the user hears sustained risks rather than per-frame noise.",
  },
  {
    title: "TTC warning",
    copy: "Distance and approach speed produce HIGH or CRITICAL warnings. A short vote window suppresses single-frame spikes.",
  },
];

const agentMechanisms = [
  {
    title: "ComboTool",
    copy: "Multi-step MCP calls and accessibility operations are wrapped as one semantic action, such as find_nearby plus navigate_to or estimate plus call_taxi.",
  },
  {
    title: "Short LID",
    copy: "Long POI IDs are mapped to L1, L2, L3. The LLM copies short identifiers; the app keeps the real IDs internally.",
  },
  {
    title: "OutputDistiller",
    copy: "Tool outputs keep only fields needed for the next decision, such as names, distances, IDs, and short status text.",
  },
  {
    title: "Stem Context",
    copy: "System prompt and tool definitions stay warm in KV Cache, so each new command only prefills the changed task context.",
  },
];

const validationRows = [
  {
    scope: "SafetyCore",
    evidence: "1,636 effective frames from three self-collected walking videos",
    result: "35.16 ms mean, P95 47.07 ms, P99 54.02 ms",
  },
  {
    scope: "Scale recovery",
    evidence: "Street and alley scenes with different ground geometry",
    result: "Recovered distance trends stay comparable enough to reuse warning thresholds",
  },
  {
    scope: "AgentCore",
    evidence: "Scripted navigation, ride-hailing, query, vision, and accessibility-control flows",
    result: "Voice-loop task routing stayed stable across the tested main paths",
  },
  {
    scope: "Full pipeline",
    evidence: "SafetyCore alone vs. SafetyCore plus AgentCore on Snapdragon 8 Gen 3",
    result: "NPU vision and GPU LLM run concurrently with CPU P95 at 51.9%",
  },
];

const interfaceScreens = [
  {
    title: "Onboarding",
    src: "/tongxing/screens/onboarding.png",
    alt: "TongXing onboarding feature screen",
    copy: "The first-run flow explains the three operating assumptions: live obstacle sensing, voice control, and a persistent floating state.",
  },
  {
    title: "Service plugins",
    src: "/tongxing/screens/services.jpg",
    alt: "TongXing service plugin settings screen",
    copy: "External services are exposed as switchable plugins, so unavailable providers do not pollute the tool list shown to the assistant.",
  },
  {
    title: "Preferences",
    src: "/tongxing/screens/preferences.jpg",
    alt: "TongXing preference settings screen",
    copy: "Speech speed, speech pitch, vibration, and obstacle-engine toggles remain visible as normal app settings rather than hidden debug flags.",
  },
  {
    title: "Safety debug view",
    src: "/tongxing/screens/safety-debug.png",
    alt: "TongXing SafetyCore debug view with obstacle overlays",
    copy: "The internal view overlays class, track ID, distance, and warning level on top of the live camera stream.",
  },
];

const agentScreens = [
  {
    title: "Ride status",
    src: "/tongxing/screens/call-taxi-result.jpg",
    alt: "TongXing ride-hailing status screenshot",
  },
  {
    title: "Train query",
    src: "/tongxing/screens/train.jpg",
    alt: "TongXing train query result screenshot",
  },
  {
    title: "Weather",
    src: "/tongxing/screens/weather.jpg",
    alt: "TongXing weather query result screenshot",
  },
  {
    title: "Screen reading",
    src: "/tongxing/screens/screen-reading-result.jpg",
    alt: "TongXing screen description screenshot",
  },
];

const padIndex = (i: number) => String(i + 1).padStart(2, "0");
const inlineCode =
  "rounded border border-border-subtle bg-code-bg px-1.5 py-0.5 font-mono text-[0.84em] text-foreground";
---

<Layout
  title="TongXing edge agentic assistive system"
  description="TongXing is an edge assistive system for blind and low-vision users, combining local NPU obstacle warning with an on-device LLM agent that closes touch-first app tasks through MCP tools and Android accessibility actions."
  ogImage="/og/tongxing.png"
  schemaType="TechArticle"
>
  <Header />
  <main id="main-content" class="app-layout">
    <article class="pt-9 pb-20 sm:pt-11">
      <header class="pb-9">
        <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs tracking-wide text-muted-foreground">
          <span>
            <a
              href="https://jsjds.blcu.edu.cn/"
              target="_blank"
              rel="noopener"
              class="font-medium text-foreground-secondary underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >4C2026</a> national second prize
          </span>
          <span aria-hidden="true" class="h-3 w-px bg-border"></span>
          <span class="tabular-nums">certificate no. 2026023242</span>
        </p>

        <h1 class="mt-3 text-3xl font-semibold leading-[1.16] tracking-tight text-foreground sm:text-4xl">
          TongXing: local perception and a voice agent on one phone
        </h1>

        <div class="mt-5 flex flex-wrap gap-2">
          {
            projectLinks.map(l => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="action-chip"
              >
                <HrefIcon href={l.href} class="size-4 shrink-0" />
                {l.label}
              </a>
            ))
          }
        </div>

        <nav aria-label="On this page" class="jump-nav mt-7">
          <a href="#evidence">Evidence</a>
          <a href="#problem">Problem</a>
          <a href="#architecture">Architecture</a>
          <a href="#deployment">Deployment</a>
          <a href="#safetycore">SafetyCore</a>
          <a href="#agentcore">AgentCore</a>
          <a href="#performance">Performance</a>
          <a href="#code">Code</a>
        </nav>
      </header>

      <section id="evidence" class="mb-14">
        <h2 class="section-eyebrow mb-3">Safety Evidence</h2>
        <p class="mb-5 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
          Three walking clips from the test assets. Each one exercises a different failure mode:
          non-standard obstacles, moving street traffic, and crowded pedestrian flow.
        </p>
        <ScrollableRow ariaLabel="TongXing SafetyCore demo videos">
          {
            safetyDemos.map(demo => (
              <section class="surface-card flex w-[min(21.5rem,calc(100vw-3.25rem))] shrink-0 flex-col p-3.5 sm:w-[25.5rem]">
                <ProjectVideo
                  src={demo.src}
                  poster={demo.poster}
                  aspectRatio="1302 / 1280"
                  rounded="rounded-md"
                  ariaLabel={`Play ${demo.title} demo`}
                  ctaLabel="Play demo"
                />
                <div class="mt-3.5 flex-1 border-t border-border-subtle pt-3">
                  <h3 class="text-base font-semibold tracking-tight text-foreground">
                    {demo.title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-foreground-secondary">
                    {demo.caption}
                  </p>
                </div>
              </section>
            ))
          }
        </ScrollableRow>
      </section>

      <section id="problem" class="mb-14">
        <h2 class="section-eyebrow mb-4">The Problem</h2>
        <div class="max-w-prose-app">
          <h3 class="mb-4 text-2xl font-semibold tracking-tight text-foreground">
            The missing piece is not another description app. It is an on-device safety loop.
          </h3>
          <div class="space-y-4 text-base leading-relaxed text-foreground-secondary">
            <p>
              A white cane is reliable, but its sensing range is short and mostly near-ground. It
              does not tell the user whether the object ahead is a parked vehicle, an approaching
              pedestrian, a pole, or a hanging obstacle.
            </p>
            <p>
              Cloud vision systems can describe rich scenes, but their latency and network dependency
              are wrong for collision warnings. Safety alerts have to survive tunnels, elevators, and
              weak signal areas.
            </p>
            <p>
              The same user also faces a digital-accessibility gap in touch-first apps. Navigation,
              taxi, train, flight, weather, and visual description need one voice loop that can recover
              from intermediate choices without forcing the user back to the screen.
            </p>
          </div>
        </div>

        <div class="mt-7 grid max-w-prose-app gap-x-7 gap-y-5 sm:grid-cols-2">
          {
            closedLoopGaps.map((gap, i) => (
              <section class="border-t border-border-subtle pt-3.5">
                <div class="flex items-baseline gap-2">
                  <span class="font-mono text-[0.6875rem] tabular-nums text-muted-foreground">
                    {padIndex(i)}
                  </span>
                  <h4 class="text-base font-semibold tracking-tight text-foreground">
                    {gap.title}
                  </h4>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
                  {gap.copy}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section class="mb-14">
        <h2 class="section-eyebrow mb-5">Why Edge</h2>
        <div class="grid gap-x-8 gap-y-6 md:grid-cols-2">
          {
            edgeRationale.map((item, i) => (
              <section class="border-t border-border-subtle pt-4">
                <span class="font-mono text-[0.6875rem] tabular-nums text-muted-foreground">
                  {padIndex(i)}
                </span>
                <h3 class="mt-1 text-base font-semibold tracking-tight text-foreground">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
                  {item.copy}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section class="mb-14">
        <h2 class="section-eyebrow mb-5">Design Constraints</h2>
        <div class="grid gap-x-7 gap-y-6 md:grid-cols-3">
          {
            designPrinciples.map((principle, i) => (
              <section class="border-t border-border-subtle pt-4">
                <span class="font-mono text-[0.6875rem] tabular-nums text-muted-foreground">
                  {padIndex(i)}
                </span>
                <h3 class="mt-1 text-base font-semibold tracking-tight text-foreground">
                  {principle.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
                  {principle.copy}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section id="system" class="mb-14">
        <h2 class="section-eyebrow mb-4">System</h2>
        <figure class="figure-frame">
          <div class="figure-paper">
            <img
              src="/tongxing/figures/system-overview-en.png"
              alt="TongXing system overview showing SafetyCore, AgentCore, user interaction, and audio priority"
              class="w-full"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
            SafetyCore handles local perception and warning priority. AgentCore handles voice intent,
            MCP tools, accessibility actions, and multi-step assistive workflows.
          </figcaption>
        </figure>
      </section>

      <section id="architecture" class="mb-14">
        <h2 class="section-eyebrow mb-4">Architecture</h2>
        <figure class="figure-frame">
          <div class="figure-paper">
            <img
              src="/tongxing/figures/tech-pipeline-en.png"
              alt="TongXing architecture diagram for SafetyCore, AgentCore, and voice interaction"
              class="w-full"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-4 max-w-prose-app text-sm leading-relaxed text-muted-foreground">
            SafetyCore, AgentCore, and the voice loop are split across NPU, GPU, and CPU so the
            warning path stays responsive while assistant tasks run.
          </figcaption>
        </figure>
        <div class="mt-7 grid gap-x-7 gap-y-6 md:grid-cols-3">
          <div class="border-t border-border-subtle pt-4">
            <h3 class="text-lg font-semibold tracking-tight text-foreground">SafetyCore</h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
              YOLOX, MiDaS, and FFNet run as independent INT8 models on the NPU. Post-fusion turns
              category, relative depth, and walkable-area semantics into tracked obstacles, distance
              estimates, TTC, and warning levels.
            </p>
          </div>
          <div class="border-t border-border-subtle pt-4">
            <h3 class="text-lg font-semibold tracking-tight text-foreground">AgentCore</h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
              Qwen3-1.7B drives a ReAct loop over 11 Combo tools and accessibility actions. The
              tool layer compresses MCP outputs, maps long POI IDs to short LIDs, and keeps repeated
              tool definitions warm in KV Cache.
            </p>
          </div>
          <div class="border-t border-border-subtle pt-4">
            <h3 class="text-lg font-semibold tracking-tight text-foreground">Voice Loop</h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
              Offline ASR and system TTS sit on the CPU path. A safety warning can stop ASR, cancel
              the active LLM request, clear lower-priority speech, and speak immediately.
            </p>
          </div>
        </div>
      </section>

      <section class="mb-14">
        <h2 class="section-eyebrow mb-5">Engineering Judgment</h2>
        <div class="divide-y divide-border-subtle border-y border-border-subtle">
          {
            engineeringJudgments.map(item => (
              <section class="grid gap-2 py-5 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-8">
                <h3 class="text-base font-semibold tracking-tight text-foreground">
                  {item.title}
                </h3>
                <p class="max-w-prose-app text-base leading-relaxed text-foreground-secondary">
                  {item.copy}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section id="deployment" class="mb-14">
        <h2 class="section-eyebrow mb-4">Edge Deployment</h2>
        <p class="mb-6 max-w-prose-app text-base leading-relaxed text-foreground-secondary">
          The project is a resource-placement exercise, not just a model demo. Six models share one
          Android process. Vision gets the NPU, language gets the GPU, and speech stays on CPU
          because safety audio must keep working while the assistant is generating.
        </p>
        <div class="grid gap-4 lg:grid-cols-3">
          {
            modelDeployments.map(item => (
              <section class="surface-card flex flex-col justify-between p-5">
                <div>
                  <h3 class="section-eyebrow-plain">{item.unit}</h3>
                  <p class="mt-2.5 text-base font-semibold tracking-tight text-foreground">
                    {item.workload}
                  </p>
                </div>
                <p class="mt-3 border-t border-border-subtle pt-3 text-sm leading-relaxed text-foreground-secondary">
                  {item.detail}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section id="safetycore" class="mb-14">
        <h2 class="section-eyebrow mb-5">SafetyCore Details</h2>
        <div class="grid gap-8 lg:grid-cols-[minmax(18rem,0.88fr)_minmax(0,1.12fr)] lg:items-start">
          <div class="space-y-6">
            <div>
              <h3 class="text-lg font-semibold tracking-tight text-foreground">
                Three models, one warning stream
              </h3>
              <p class="mt-2 text-base leading-relaxed text-foreground-secondary">
                YOLOX supplies object boxes for common categories such as people and vehicles.
                MiDaS supplies relative depth. FFNet marks walkable ground and structural obstacles
                such as poles, walls, and fences. The post-fusion layer keeps the three models
                independent, so any model can be replaced or re-quantized without retraining a fused
                network.
              </p>
            </div>
            <div class="border-t border-border-subtle pt-5">
              <h3 class="text-lg font-semibold tracking-tight text-foreground">
                Ground-constrained scale recovery
              </h3>
              <p class="mt-2 text-base leading-relaxed text-foreground-secondary">
                MiDaS depth is relative, so TongXing uses the chest-mounted camera assumption and
                FFNet ground pixels to recover a scene scale. A short median history smooths the
                scale factor. If ground pixels are unreliable, the system falls back conservatively
                instead of speaking overconfident warnings.
              </p>
            </div>
            <div class="border-t border-border-subtle pt-5">
              <h3 class="text-lg font-semibold tracking-tight text-foreground">
                Tracking before warning
              </h3>
              <p class="mt-2 text-base leading-relaxed text-foreground-secondary">
                DeepSORT-style tracking links detections across frames, then the warning layer uses
                distance, approach speed, central-region constraints, and a short vote window before
                speaking. This is why the demo emphasizes sustained warnings rather than single-frame
                detections.
              </p>
            </div>
          </div>
          <figure class="figure-frame">
            <div class="figure-paper">
              <img
                src="/tongxing/figures/scale-recovery-en.png"
                alt="Scale recovery diagram using ground pixels and chest-mounted camera geometry"
                class="w-full"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-4 text-sm leading-relaxed text-muted-foreground">
              Ground segmentation turns relative monocular depth into a usable distance signal for
              warning thresholds.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="mb-14">
        <h2 class="section-eyebrow mb-5">Warning Pipeline</h2>
        <div class="grid gap-x-8 gap-y-6 md:grid-cols-2">
          {
            safetyPipeline.map((item, i) => (
              <section class="border-t border-border-subtle pt-4">
                <span class="font-mono text-[0.6875rem] uppercase tracking-widest text-muted-foreground">
                  Stage {padIndex(i)}
                </span>
                <h3 class="mt-1 text-base font-semibold tracking-tight text-foreground">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
                  {item.copy}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section id="agentcore" class="mb-14">
        <h2 class="section-eyebrow mb-3">AgentCore Showcase</h2>
        <p class="mb-5 max-w-prose-app text-base leading-relaxed text-foreground-secondary">
          AgentCore is tuned to close short app tasks through voice rather than open-ended chat.
        </p>
        <ScrollableRow ariaLabel="TongXing AgentCore showcase">
          <figure class="surface-card flex w-[16.25rem] shrink-0 flex-col p-3.5">
            <div class="w-full overflow-hidden rounded-md [&>figure]:w-full">
              <ProjectVideo
                src="/tongxing/videos/navigate-to.mp4"
                poster="/tongxing/posters/navigate-to.jpg"
                aspectRatio="1264 / 2780"
                rounded="rounded-md"
                ariaLabel="Play voice navigation demo"
                ctaLabel="Play demo"
              />
            </div>
            <figcaption class="mt-3 border-t border-border-subtle pt-2.5">
              <h3 class="text-sm font-semibold tracking-tight text-foreground">
                Voice navigation
              </h3>
            </figcaption>
          </figure>
          {
            agentScreens.map(item => (
              <figure class="surface-card flex w-[16.25rem] shrink-0 flex-col p-3.5">
                <div class="aspect-[1264/2780] w-full overflow-hidden rounded-md border border-border-subtle bg-surface-2">
                  <img
                    src={item.src}
                    alt={item.alt}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <figcaption class="mt-3 border-t border-border-subtle pt-2.5">
                  <h3 class="text-sm font-semibold tracking-tight text-foreground">
                    {item.title}
                  </h3>
                </figcaption>
              </figure>
            ))
          }
        </ScrollableRow>
      </section>

      <section class="mb-14">
        <h2 class="section-eyebrow mb-5">AgentCore Mechanics</h2>
        <div class="grid gap-x-8 gap-y-6 md:grid-cols-2">
          {
