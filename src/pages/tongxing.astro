            <tbody>
              {validationRows.map(row => (
                <tr class="border-b border-border/70">
                  <td class="py-4 pr-4 align-top font-semibold">{row.scope}</td>
                  <td class="py-4 pr-4 align-top text-foreground/80">{row.evidence}</td>
                  <td class="py-4 align-top text-foreground/80">{row.result}</td>
