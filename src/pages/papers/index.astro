---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HrefIcon from "@/components/HrefIcon.astro";
import IconArrowRight from "@/assets/icons/octicons/arrow-right-16.svg";
import { paperStatusClass, paperStatusLabel } from "@/utils/paperStatus";
import { SITE } from "@/config";

const papers = await getCollection("papers");
const sortedPapers = papers.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const grouped = sortedPapers.reduce<Record<number, typeof sortedPapers>>(
  (acc, p) => {
    const y = p.data.year;
    (acc[y] ||= []).push(p);
    return acc;
  },
  {}
);
const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);

const fmtAuthors = (authors: { name: string; isMe?: boolean }[]) =>
  authors
    .map(a => (a.isMe ? `<strong class="text-foreground">${a.name}</strong>` : a.name))
    .join(", ");
---

<Layout title={`Papers · ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-10 pb-20">
    <header class="mb-10">
      <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
        Manuscripts
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Papers</h1>
      <p class="mt-3 max-w-prose-app text-muted-foreground">
        Manuscripts and preprints. My name is
        <strong class="text-foreground">bold</strong>; each listing shows the current
        status and available artifacts.
      </p>
    </header>

    {
      years.map(year => (
        <section class="mb-12">
          <h2 class="mb-5 font-mono text-sm tabular-nums text-muted-foreground">
            {year}
          </h2>
          <ul class="space-y-8 border-t border-border pt-6">
            {grouped[year].map(p => (
              <li>
                <div class="flex flex-wrap items-baseline gap-x-2 font-mono text-xs">
                  <span class={paperStatusClass(p.data.status)}>
                    {paperStatusLabel(p.data.status)}
                  </span>
                  <span class="text-muted-foreground/50" aria-hidden>·</span>
                  <span class="text-muted-foreground">{p.data.venue}</span>
                </div>

                <h3 class="mt-2 text-lg font-medium leading-snug">
                  {p.data.hasProjectPage && p.data.projectPageSlug ? (
                    <a
                      href={`/${p.data.projectPageSlug}`}
                      class="hover:text-accent"
                    >
                      {p.data.title}
                    </a>
                  ) : (
                    p.data.title
                  )}
                </h3>

                <p
                  class="mt-1 text-sm text-muted-foreground"
                  set:html={fmtAuthors(p.data.authors)}
                />

                {p.data.tldr && (
                  <p class="mt-2 max-w-prose-app text-sm text-foreground/80">
                    {p.data.tldr}
                  </p>
                )}

                <div class="mt-3 flex flex-wrap gap-2">
                  {p.data.hasProjectPage && p.data.projectPageSlug && (
                    <a
                      href={`/${p.data.projectPageSlug}`}
                      class="action-chip action-chip-sm"
                    >
                      Project page
                      <IconArrowRight class="size-3.5 shrink-0" />
                    </a>
                  )}
                  {p.data.links.map(l => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="action-chip action-chip-sm"
                    >
                      <HrefIcon href={l.href} />
                      {l.label}
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>
