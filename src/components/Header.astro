---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(path + "/");
};

const navItems: { href: string; label: string }[] = [
  { href: "/", label: "Home" },
  { href: "/anvil", label: "ANVIL" },
  { href: "/tongxing", label: "TongXing" },
  { href: "/about", label: "About" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="fixed start-4 -top-full z-50 rounded-md border border-border bg-background/95 px-3 py-2 font-mono text-xs text-accent shadow-sm backdrop-blur-md transition-all focus:top-3"
>
  Skip to content
</a>

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-border/80 bg-background/85 backdrop-blur-md"
>
  <nav
    id="nav-menu"
    aria-label="Primary"
    class="app-layout flex flex-wrap items-center justify-between"
  >
    <div class="flex h-14 items-center">
      <a
        href="/"
        class="font-mono text-sm font-medium tracking-tight text-foreground transition-colors hover:text-accent"
        aria-label={SITE.title}
      >
        ~/{SITE.author.toLowerCase()}
      </a>
    </div>

    <button
      id="menu-btn"
      type="button"
      class="-mr-2 inline-flex size-10 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-surface-1 hover:text-foreground sm:hidden"
      aria-label="Open Menu"
      aria-expanded="false"
      aria-controls="menu-items"
    >
      <IconX id="close-icon" class="hidden size-5" />
      <IconMenuDeep id="menu-icon" class="size-5" />
    </button>

    <ul
      id="menu-items"
      class="hidden w-full flex-col gap-y-0.5 border-t border-border-subtle py-2.5 sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-x-6 sm:border-t-0 sm:py-0"
    >
      {
        navItems.map(({ href, label }) => (
          <li class="sm:flex sm:h-14 sm:items-center">
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class:list={[
                "flex w-full items-center py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline-flex sm:h-full sm:w-auto sm:px-0.5 sm:py-0",
                { "active-nav": isActive(href) },
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      {
        SITE.lightAndDarkMode && (
          <li class="mt-1.5 flex items-center justify-between border-t border-border-subtle pt-2 sm:mt-0 sm:ms-1 sm:h-14 sm:border-t-0 sm:border-l sm:border-border-subtle sm:ps-4 sm:pt-0">
            <span class="font-mono text-xs uppercase tracking-wider text-muted-foreground sm:hidden">
              Theme
            </span>
            <button
              id="theme-btn"
              type="button"
              class="relative inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-surface-1 hover:text-foreground hover:[&>svg]:stroke-accent"
              title="Toggle light & dark"
              aria-label="Switch theme"
              aria-live="polite"
            >
              <IconMoon class="absolute top-1/2 left-1/2 h-4 w-4 -translate-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-1/2 left-1/2 h-4 w-4 -translate-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  type HeaderDelegatedWindow = Window & { __siteHeaderOutsideBound?: boolean };

  function closeHeaderMenu() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector<HTMLElement>("#menu-icon");
    const closeIcon = document.querySelector<HTMLElement>("#close-icon");
    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;
    if (menuBtn.getAttribute("aria-expanded") !== "true") return;

    menuBtn.setAttribute("aria-expanded", "false");
    menuBtn.setAttribute("aria-label", "Open Menu");
    menuItems.classList.add("hidden");
    menuItems.classList.remove("flex");
    menuIcon.classList.remove("hidden");
    closeIcon.classList.add("hidden");
  }

  function toggleNav() {
    const header = document.querySelector<HTMLElement>("#site-header");
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector<HTMLElement>("#menu-icon");
    const closeIcon = document.querySelector<HTMLElement>("#close-icon");

    if (!header || !menuBtn || !menuItems || !menuIcon || !closeIcon) return;
    if (menuBtn.dataset.bound === "true") return;
    menuBtn.dataset.bound = "true";

    const setOpen = (nextOpen: boolean) => {
      menuBtn.setAttribute("aria-expanded", nextOpen ? "true" : "false");
      menuBtn.setAttribute("aria-label", nextOpen ? "Close Menu" : "Open Menu");
      menuItems.classList.toggle("hidden", !nextOpen);
      menuItems.classList.toggle("flex", nextOpen);
      menuIcon.classList.toggle("hidden", nextOpen);
      closeIcon.classList.toggle("hidden", !nextOpen);
    };

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      setOpen(!isOpen);
    });

    menuItems.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => setOpen(false));
    });

    header.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        menuBtn.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false);
        menuBtn.focus();
      }
    });

    const w = window as HeaderDelegatedWindow;
    if (!w.__siteHeaderOutsideBound) {
      w.__siteHeaderOutsideBound = true;
      document.addEventListener("click", event => {
        const currentHeader = document.querySelector<HTMLElement>("#site-header");
        if (
          currentHeader &&
          event.target instanceof Node &&
          !currentHeader.contains(event.target)
        ) {
          closeHeaderMenu();
        }
      });
    }
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
  document.addEventListener("astro:page-load", toggleNav);
</script>
