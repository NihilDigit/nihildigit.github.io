---
import type { HTMLAttributes } from "astro/types";
import IconClaude from "@/assets/icons/IconClaude.svg";
import IconOpenAI from "@/assets/icons/IconOpenAI.svg";
import IconKimi from "@/assets/icons/IconKimi.svg";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-t border-border py-8 text-xs text-muted-foreground">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="space-y-1">
        <div class="font-mono uppercase tracking-wider">© {currentYear} NihilDigit</div>
        <p>
          <a
            href="https://github.com/NihilDigit/nihildigit.github.io"
            target="_blank"
            rel="noopener"
            class="hover:text-foreground"
          >
            Source
          </a>
        </p>
      </div>
      <p class="sm:text-right">
        <span class="inline-flex flex-wrap items-center gap-1.5">
          Built with
          <a
            href="https://claude.com/claude-code"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1 hover:text-foreground"
          >
            <IconClaude class="inline-block h-3.5 w-3.5" />
            <span>Claude,</span>
          </a>
          <a
            href="https://openai.com/codex/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1 hover:text-foreground"
          >
            <IconOpenAI class="inline-block h-3.5 w-3.5" />
            GPT and
          </a>
          <a
            href="https://www.kimi.com/code"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1 hover:text-foreground"
          >
            <IconKimi class="relative -top-px inline-block h-3.5 w-3.5" />
            Kimi.
          </a>
        </span>
      </p>
    </div>
  </div>
</footer>
