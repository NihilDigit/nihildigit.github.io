---
import type { HTMLAttributes } from "astro/types";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-t border-border py-8 text-sm text-muted-foreground">
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-wider">Site</div>
        <ul class="space-y-1">
          <li>
            <a href="/notes" class="hover:text-foreground">Notes archive</a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-foreground">RSS</a>
          </li>
        </ul>
      </div>
      <div class="space-y-2 sm:text-right">
        <div class="font-mono text-xs uppercase tracking-wider">© {currentYear}</div>
        <p class="text-xs">
          <span class="inline-flex items-center gap-1.5">
            NihilDigit. Built with
            <a
              href="https://claude.com/claude-code"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 hover:text-foreground"
              aria-label="Claude"
            >
              <img
                src="/claude-icon.png"
                alt=""
                width="14"
                height="14"
                class="inline-block"
                loading="lazy"
                decoding="async"
              />
              <span>Claude</span>
            </a>.
          </span>
          <br />
          <a
            href="https://github.com/NihilDigit/nihildigit.github.io"
            class="hover:text-foreground">Source</a
          >.
        </p>
      </div>
    </div>
  </div>
</footer>
