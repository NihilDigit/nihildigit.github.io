---
interface Props {
  src: string;
  poster?: string;
  fileSize?: string;
  aspectRatio?: string;
  rounded?: string;
  caption?: string;
  priority?: boolean;
  ariaLabel?: string;
  ctaLabel?: string;
}

const {
  src,
  poster,
  fileSize,
  aspectRatio = "16 / 9",
  rounded = "rounded-md",
  caption,
  priority = false,
  ariaLabel = "Play project video",
  ctaLabel = "Play video",
} = Astro.props;
---

<!--
  bg-black / text-white literals are deliberate. The play overlay is video
  chrome, so it should stay readable regardless of the site's light/dark theme.
-->
<figure class="w-full">
  <div
    data-project-video
    data-video-src={src}
    data-video-poster={poster ?? ""}
    data-video-aspect={aspectRatio}
    data-video-rounded={rounded}
    class:list={[
      "group relative w-full cursor-pointer overflow-hidden border border-border bg-muted transition-colors hover:border-accent/40",
      rounded,
    ]}
    style={`aspect-ratio: ${aspectRatio};`}
    role="button"
    tabindex="0"
    aria-label={ariaLabel}
  >
    {
      poster && (
        <img
          src={poster}
          alt=""
          class="h-full w-full object-cover"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
          decoding="async"
        />
      )
    }
    <div
      class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover:bg-black/45"
    >
      <span
        class="inline-flex items-center gap-2 rounded-md bg-black/70 px-4 py-2 font-mono text-xs uppercase tracking-widest text-white backdrop-blur"
      >
        <svg
          class="h-3 w-3"
          viewBox="0 0 12 12"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M2 1l9 5-9 5z"></path>
        </svg>
        {ctaLabel}{fileSize ? ` · ${fileSize}` : ""}
      </span>
    </div>
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-center font-mono text-xs text-muted-foreground">
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  function initProjectVideo() {
    const triggers = document.querySelectorAll<HTMLElement>(
      "[data-project-video]"
    );
    triggers.forEach(trigger => {
      if (trigger.dataset.bound === "true") return;
      trigger.dataset.bound = "true";

      const activate = () => {
        const src = trigger.dataset.videoSrc;
        const poster = trigger.dataset.videoPoster;
        const aspect = trigger.dataset.videoAspect ?? "16 / 9";
        const rounded = trigger.dataset.videoRounded ?? "rounded-md";
        if (!src) return;

        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const video = document.createElement("video");
        video.src = src;
        if (poster) video.poster = poster;
        video.controls = true;
        video.autoplay = true;
        video.muted = true;
        video.loop = !reducedMotion;
        video.playsInline = true;
        video.preload = "auto";
        video.className = `w-full ${rounded} border border-border bg-black`;
        video.style.aspectRatio = aspect;
        trigger.replaceWith(video);
        video.play().catch(() => {
          /* user-gesture should already be present from click */
        });
      };

      trigger.addEventListener("click", activate);
      trigger.addEventListener("keydown", e => {
        const k = (e as KeyboardEvent).key;
        if (k === "Enter" || k === " ") {
          e.preventDefault();
          activate();
        }
      });
    });
  }

  initProjectVideo();
  document.addEventListener("astro:page-load", initProjectVideo);
</script>
