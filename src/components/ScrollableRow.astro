---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";

interface Props {
  ariaLabel?: string;
  class?: string;
}

const { ariaLabel = "Scrollable content", class: className = "" } = Astro.props;
---

<div class:list={["relative", className]} data-embla-row>
  <div
    data-embla-row-viewport
    class:list={[
      "overflow-hidden pb-3",
      "[-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
    ]}
    role="region"
    aria-label={ariaLabel}
    tabindex="0"
  >
    <div class="flex items-stretch gap-4">
      <slot />
    </div>
  </div>

  <button
    type="button"
    data-embla-row-prev
    class="absolute top-1/2 left-2 z-10 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-md bg-accent text-accent-foreground shadow-sm ring-1 ring-background/70 transition-transform hover:scale-105"
    aria-label="Previous items"
  >
    <IconChevronLeft class="h-5 w-5" />
  </button>
  <button
    type="button"
    data-embla-row-next
    class="absolute top-1/2 right-2 z-10 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-md bg-accent text-accent-foreground shadow-sm ring-1 ring-background/70 transition-transform hover:scale-105"
    aria-label="Next items"
  >
    <IconChevronRight class="h-5 w-5" />
  </button>
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  function initEmblaRows() {
    const shells = document.querySelectorAll<HTMLElement>("[data-embla-row]");

    shells.forEach(shell => {
      if (shell.dataset.bound === "true") return;
      shell.dataset.bound = "true";

      const viewport = shell.querySelector<HTMLElement>(
        "[data-embla-row-viewport]"
      );
      const prev = shell.querySelector<HTMLButtonElement>("[data-embla-row-prev]");
      const next = shell.querySelector<HTMLButtonElement>("[data-embla-row-next]");
      if (!viewport || !prev || !next) return;

      const embla = EmblaCarousel(viewport, {
        align: "start",
        containScroll: false,
        dragFree: false,
        loop: true,
        skipSnaps: true,
      });

      prev.addEventListener("click", () => embla.scrollPrev());
      next.addEventListener("click", () => embla.scrollNext());
    });
  }

  initEmblaRows();
  document.addEventListener("astro:page-load", initEmblaRows);
</script>
