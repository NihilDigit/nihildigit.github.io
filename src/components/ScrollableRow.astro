---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";

interface Props {
  ariaLabel?: string;
  class?: string;
  loop?: boolean;
}

const {
  ariaLabel = "Scrollable content",
  class: className = "",
  loop = true,
} = Astro.props;
---

<div class:list={["relative", className]} data-embla-row data-loop={String(loop)}>
  <div
    data-embla-row-viewport
    class:list={[
      "overflow-hidden pb-3",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed focus-visible:outline-accent",
      "[-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
    ]}
    role="region"
    aria-label={ariaLabel}
    aria-roledescription="carousel"
    tabindex="0"
  >
    <div class="flex items-stretch gap-4">
      <slot />
    </div>
  </div>

  <button
    type="button"
    data-embla-row-prev
    class="absolute top-1/2 left-2 z-10 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-md bg-accent text-accent-foreground shadow-sm ring-1 ring-background/70 transition-transform hover:scale-105 disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none motion-reduce:hover:scale-100"
    aria-label="Previous items"
  >
    <IconChevronLeft class="h-5 w-5" />
  </button>
  <button
    type="button"
    data-embla-row-next
    class="absolute top-1/2 right-2 z-10 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-md bg-accent text-accent-foreground shadow-sm ring-1 ring-background/70 transition-transform hover:scale-105 disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none motion-reduce:hover:scale-100"
    aria-label="Next items"
  >
    <IconChevronRight class="h-5 w-5" />
  </button>
</div>

<script>
  import EmblaCarousel from "embla-carousel";
  import type { EmblaCarouselType } from "embla-carousel";

  function disableCloneFocus(root: HTMLElement) {
    root.setAttribute("aria-hidden", "true");
    root
      .querySelectorAll<HTMLElement>(
        "a, button, input, select, textarea, [tabindex], [role='button']"
      )
      .forEach(el => {
        el.setAttribute("tabindex", "-1");
        delete el.dataset.bound;
      });
  }

  function ensureLoopableTrack(viewport: HTMLElement) {
    const track = viewport.firstElementChild;
    if (!(track instanceof HTMLElement)) return;
    if (track.dataset.loopFilled === "true") return;

    const originals = Array.from(track.children).filter(
      child => !(child instanceof HTMLElement && child.dataset.emblaClone)
    );
    if (originals.length < 2) return;

    let pass = 0;
    while (
      track.scrollWidth < viewport.clientWidth * 2.5 &&
      track.children.length < originals.length * 4 &&
      pass < 3
    ) {
      originals.forEach(original => {
        const clone = original.cloneNode(true);
        if (!(clone instanceof HTMLElement)) return;
        clone.dataset.emblaClone = "true";
        disableCloneFocus(clone);
        track.append(clone);
      });
      pass += 1;
    }

    track.dataset.loopFilled = "true";
  }

  function initEmblaRows() {
    const shells = document.querySelectorAll<HTMLElement>("[data-embla-row]");

    shells.forEach(shell => {
      if (shell.dataset.bound === "true") return;
      shell.dataset.bound = "true";

      const viewport = shell.querySelector<HTMLElement>(
        "[data-embla-row-viewport]"
      );
      const prev = shell.querySelector<HTMLButtonElement>("[data-embla-row-prev]");
      const next = shell.querySelector<HTMLButtonElement>("[data-embla-row-next]");
      if (!viewport || !prev || !next) return;

      const shouldLoop = shell.dataset.loop !== "false";
      if (shouldLoop) ensureLoopableTrack(viewport);

      const embla = EmblaCarousel(viewport, {
        align: "start",
        containScroll: false,
        dragFree: false,
        loop: shouldLoop,
        skipSnaps: true,
      });

      shellEmblaInstances.set(shell, embla);

      const syncControls = () => {
        prev.disabled = !embla.canScrollPrev();
        next.disabled = !embla.canScrollNext();
        prev.toggleAttribute("aria-disabled", prev.disabled);
        next.toggleAttribute("aria-disabled", next.disabled);
      };

      prev.addEventListener("click", () => embla.scrollPrev());
      next.addEventListener("click", () => embla.scrollNext());
      viewport.addEventListener("keydown", event => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          embla.scrollPrev();
        }
        if (event.key === "ArrowRight") {
          event.preventDefault();
          embla.scrollNext();
        }
      });

      embla.on("select", syncControls);
      embla.on("reInit", syncControls);
      syncControls();
    });
  }

  const shellEmblaInstances = new WeakMap<HTMLElement, EmblaCarouselType>();

  function destroyEmblaRows() {
    const shells = document.querySelectorAll<HTMLElement>("[data-embla-row]");

    shells.forEach(shell => {
      const embla = shellEmblaInstances.get(shell);
      if (!embla) return;
      embla.destroy();
      shellEmblaInstances.delete(shell);
      delete shell.dataset.bound;
    });
  }

  initEmblaRows();
  document.addEventListener("astro:page-load", initEmblaRows);
  document.addEventListener("astro:before-swap", destroyEmblaRows);
</script>
