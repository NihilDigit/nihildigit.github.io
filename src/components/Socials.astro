---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="inline-flex size-11 items-center justify-center transition-transform duration-200 ease-out hover:rotate-6 motion-reduce:transition-none motion-reduce:hover:rotate-0"
        title={social.linkTitle}
      >
        <social.icon class="inline-block size-6 scale-125 opacity-90 sm:scale-110" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>
