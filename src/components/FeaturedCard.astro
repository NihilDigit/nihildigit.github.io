---
import IconGitHub from "@/assets/icons/octicons/mark-github-16.svg";
import IconTrophy from "@/assets/icons/octicons/trophy-16.svg";
import ActionLinks from "@/components/ActionLinks.astro";
import ContributionRow from "@/components/ContributionRow.astro";
import FeaturedImage from "@/components/FeaturedImage.astro";
import HrefIcon from "@/components/HrefIcon.astro";
import KeyNumbers from "@/components/KeyNumbers.astro";
import RepoStats from "@/components/RepoStats.astro";
import type { ResolvedFeatured } from "@/utils/featuredContributions";

interface Props {
  entry: ResolvedFeatured;
  stars?: number;
  downloads?: number;
}

const { entry, stars, downloads } = Astro.props;
const isGitHubTitle = entry.data.titleHref?.includes("github.com");
const isExternalHref = (href: string) => /^https?:\/\//.test(href);
---

<section
  id={`featured-${entry.id}`}
  class="border-t border-border-subtle py-11 sm:py-12"
  data-reveal
>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
    <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
      {entry.data.titleHref ? (
        <a
          href={entry.data.titleHref}
          target={isExternalHref(entry.data.titleHref) ? "_blank" : undefined}
          rel={isExternalHref(entry.data.titleHref) ? "noopener" : undefined}
          class="transition-colors hover:text-accent"
        >
          {isGitHubTitle && (
            <IconGitHub class="mr-2 inline-block h-[0.85em] w-[0.85em] align-[-0.07em]" />
          )}
          {entry.data.titleIcon === "trophy" && (
            <IconTrophy class="mr-2 inline-block h-[0.85em] w-[0.85em] align-[-0.07em]" />
          )}
          {entry.data.title}
        </a>
      ) : (
        entry.data.title
      )}
    </h3>

    <RepoStats stars={stars} />
  </div>

  {entry.data.metaTags.length > 0 && (
    <ul class="mt-3 flex flex-wrap items-center gap-1.5 font-mono text-xs text-muted-foreground">
      {entry.data.metaTags.map(t => (
        <li class="rounded border border-border-subtle bg-surface-1 px-2 py-0.5">
          {t}
        </li>
      ))}
    </ul>
  )}

  {entry.data.image ? (
    <div class="mt-5 grid gap-6 md:grid-cols-2">
      <FeaturedImage image={entry.data.image} />
      {/* Stretched to the image's height so the buttons sit on its bottom edge. */}
      <div class="flex flex-col justify-between">
        <p class="leading-relaxed text-foreground-secondary">{entry.data.summary}</p>
        <ActionLinks links={entry.data.links} downloads={downloads} />
      </div>
    </div>
  ) : (
    <div class="mt-4">
      <p class="max-w-5xl leading-relaxed text-foreground-secondary">
        {entry.data.summary}
      </p>
      <ActionLinks links={entry.data.links} downloads={downloads} />
    </div>
  )}

  {entry.data.keyNumbers.length > 0 && <KeyNumbers items={entry.data.keyNumbers} />}

  {entry.data.contributions.length > 0 && (
    <div
      class="contribution-block mt-6"
      data-expanded={entry.data.highlightContributions.length > 0 ? "false" : "true"}
    >
      <div class="surface-card overflow-hidden">
        {entry.data.highlightContributions.length > 0 && (
          <div class="contribution-collapsed">
            <div class="border-b border-border-subtle bg-surface-2/45 px-3.5 py-2 sm:px-4">
              <span class="section-eyebrow-plain">Selected pull requests</span>
            </div>
            <ol class="divide-y divide-border-subtle">
              {entry.data.highlightContributions.map(item => (
                <ContributionRow item={item} />
              ))}
            </ol>
          </div>
        )}

        <div class="contribution-expanded">
          {entry.data.contributionsSource === "open-ani" && (
            <div
              class="flex flex-wrap items-center justify-between gap-2 border-b border-border-subtle bg-surface-2/45 px-3.5 py-2 font-mono text-xs sm:px-4"
              data-contribution-sort
            >
              <span class="section-eyebrow-plain">
                All {entry.data.contributions.length} merged pull requests
              </span>
              <div class="flex items-center gap-2">
                <span class="text-[0.7rem] uppercase tracking-wider text-muted-foreground">
                  Sort
                </span>
                <div
                  role="group"
                  aria-label="Sort contributions"
                  class="inline-flex rounded-md border border-border bg-background p-0.5"
                >
                  <button type="button" data-sort-by="lines" aria-pressed="false" class="sort-toggle">
                    By diff
                  </button>
                  <button type="button" data-sort-by="time" aria-pressed="true" class="sort-toggle">
                    By date
                  </button>
                </div>
              </div>
            </div>
          )}

          <div
            class:list={[
              entry.data.contributions.length > 10 &&
                "max-h-[30rem] overflow-y-auto",
            ]}
            data-visible-rows={entry.data.contributions.length > 10 ? 8 : undefined}
          >
            <ol
              class="divide-y divide-border-subtle"
              data-contribution-list
            >
              {entry.data.contributions.map((item, i, items) => {
                const showGroup =
                  item.group && item.group !== items[i - 1]?.group;

                return (
                  <>
                    {showGroup && (
                      <li class="bg-surface-2/35 px-3.5 py-2 font-mono text-[0.65rem] uppercase tracking-widest text-muted-foreground sm:px-4">
                        {item.group}
                      </li>
                    )}
                    <ContributionRow item={item} />
                  </>
                );
              })}
            </ol>
          </div>
        </div>
      </div>

      {entry.data.highlightContributions.length > 0 && (
        <div class="mt-2 flex justify-end">
          <button
            type="button"
            data-contribution-toggle
            aria-expanded="false"
            class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 font-mono text-xs font-medium text-muted-foreground transition-colors hover:bg-surface-2/70 hover:text-accent"
          >
            <span class="toggle-label-closed">
              Show all {entry.data.contributions.length} merged PRs
            </span>
            <span class="toggle-label-open">
              Show selected PRs
            </span>
            <svg
              class="toggle-triangle size-2.5 shrink-0 transition-transform duration-150"
              viewBox="0 0 10 6"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M1 1h8L5 5.25z" />
            </svg>
          </button>
        </div>
      )}
    </div>
  )}

  {entry.data.badges.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {entry.data.badges.map(b =>
        b.label ? (
          b.href ? (
        <a
          href={b.href}
          target={isExternalHref(b.href) ? "_blank" : undefined}
          rel={isExternalHref(b.href) ? "noopener" : undefined}
          class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground transition-colors hover:text-accent"
        >
          <HrefIcon href={b.href} />
          <span class="underline decoration-dotted underline-offset-4">
            {b.label}
          </span>
        </a>
          ) : (
            <span class="font-mono text-xs text-muted-foreground">
              {b.label}
            </span>
          )
        ) : b.href && b.src ? (
          <a
            href={b.href}
            target={isExternalHref(b.href) ? "_blank" : undefined}
            rel={isExternalHref(b.href) ? "noopener" : undefined}
            aria-label={b.alt}
          >
            <img src={b.src} alt={b.alt ?? ""} class="h-5" />
          </a>
        ) : b.src ? (
          <img src={b.src} alt={b.alt ?? ""} class="h-5" />
        ) : (
          null
        )
      )}
    </div>
  )}

</section>

<style>
  .contribution-block[data-expanded="false"] .contribution-expanded {
    display: none;
  }
  .contribution-block[data-expanded="true"] .contribution-collapsed {
    display: none;
  }
  .contribution-block .toggle-label-open {
    display: none;
  }
  .contribution-block[data-expanded="true"] .toggle-label-closed {
    display: none;
  }
  .contribution-block[data-expanded="true"] .toggle-label-open {
    display: inline;
  }
  .contribution-block[data-expanded="true"] .toggle-triangle {
    transform: rotate(180deg);
  }
</style>
