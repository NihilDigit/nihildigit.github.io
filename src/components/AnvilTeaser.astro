---
import ProjectVideo from "@/components/ProjectVideo.astro";

interface Props {
  src: string;
  poster?: string;
  fileSize?: string;
  aspectRatio?: string;
  rounded?: string;
  caption?: string;
  priority?: boolean;
}

const {
  src,
  poster,
  fileSize = "31 MB",
  aspectRatio = "2780 / 1264",
  rounded = "rounded-md",
  caption,
  priority = false,
} = Astro.props;
---

<ProjectVideo
  src={src}
  poster={poster}
  fileSize={fileSize}
  aspectRatio={aspectRatio}
  rounded={rounded}
  caption={caption}
  priority={priority}
  ariaLabel="Play teaser video"
  ctaLabel="Play teaser"
/>
