---
import IconArrowRight from "@/assets/icons/octicons/arrow-right-16.svg";
import HrefIcon from "@/components/HrefIcon.astro";
import { formatStars } from "@/utils/githubStats";

interface Props {
  links: { label: string; href: string }[];
  // Total release downloads, shown inside the primary button when that button
  // points to the project's releases.
  downloads?: number;
}

const { links, downloads } = Astro.props;
const opensInNewTab = (href: string) =>
  /^https?:\/\//.test(href) || /\.pdf$/i.test(href);
---

{
  links.length > 0 && (
    <div class="mt-5 flex flex-wrap justify-end gap-2">
      {links.map((l, i) => {
        // The rightmost link is the card's main action and gets the same black
        // button as ANVIL's project page; leading items stay secondary chips.
        const isPrimary = i === links.length - 1;
        const newTab = opensInNewTab(l.href);
        return (
          <a
            href={l.href}
            target={newTab ? "_blank" : undefined}
            rel={newTab ? "noopener" : undefined}
            class:list={["action-chip", isPrimary && "action-chip-primary"]}
          >
            {(newTab || !isPrimary) && (
              <HrefIcon href={l.href} class="size-4 shrink-0" />
            )}
            {l.label}
            {isPrimary && downloads !== undefined && (
              <span class="font-normal">{formatStars(downloads)} downloads</span>
            )}
            {!newTab && <IconArrowRight class="size-4 shrink-0" />}
          </a>
        );
      })}
    </div>
  )
}
